              "patch": "Index: cmd/entire/cli/prompts/index/store.go\n===================================================================\n--- cmd/entire/cli/prompts/index/store.go\t\n+++ cmd/entire/cli/prompts/index/store.go\t\n@@ -1,414 +1,414 @@\n package index\n \n import (\n \t\"bufio\"\n \t\"context\"\n \t\"encoding/json\"\n \t\"errors\"\n \t\"fmt\"\n \t\"os\"\n \t\"path/filepath\"\n \t\"regexp\"\n \t\"sort\"\n \t\"strconv\"\n \t\"strings\"\n \t\"time\"\n \n \t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n )\n \n const (\n \tIndexDirName  = \"prompts\"\n \tIndexFileName = \"index.ndjson\"\n \tLockFileName  = \"index.lock\"\n )\n \n var (\n-\tErrIndexMissing     = errors.New(\"prompt index not found\")\n+\tErrIndexMissing      = errors.New(\"prompt index not found\")\n \tErrIndexCorrupt      = errors.New(\"prompt index is corrupt\")\n \tErrIndexVersionNewer = errors.New(\"prompt index was created by a newer version of the CLI\")\n \tErrIndexEmpty        = errors.New(\"prompt index is empty\")\n )\n \n type IndexStore struct {\n \trepoRoot  string\n \tindexPath string\n \tlockPath  string\n }\n \n func NewIndexStore(repoRoot string) *IndexStore {\n \tentireDir := filepath.Join(repoRoot, paths.EntireDir)\n \tindexDir := filepath.Join(entireDir, IndexDirName)\n \treturn &IndexStore{\n \t\trepoRoot:  repoRoot,\n \t\tindexPath: filepath.Join(indexDir, IndexFileName),\n \t\tlockPath:  filepath.Join(indexDir, LockFileName),\n \t}\n }\n \n func (s *IndexStore) IndexPath() string {\n \treturn s.indexPath\n }\n \n func (s *IndexStore) LockPath() string {\n \treturn s.lockPath\n }\n \n func (s *IndexStore) IndexDir() string {\n \treturn filepath.Dir(s.indexPath)\n }\n \n func (s *IndexStore) Exists() bool {\n \t_, err := os.Stat(s.indexPath)\n \treturn err == nil\n }\n \n func (s *IndexStore) Load(ctx context.Context) (*IndexHeader, []PromptEntry, error) {\n \tif err := ctx.Err(); err != nil {\n \t\treturn nil, nil, err\n \t}\n \n \tf, err := os.Open(s.indexPath)\n \tif err != nil {\n \t\tif os.IsNotExist(err) {\n \t\t\treturn nil, nil, ErrIndexMissing\n \t\t}\n \t\treturn nil, nil, fmt.Errorf(\"opening index: %w\", err)\n \t}\n \tdefer f.Close()\n \n \tscanner := bufio.NewScanner(f)\n \tvar header IndexHeader\n \tvar entries []PromptEntry\n \tlineNum := 0\n \n \tfor scanner.Scan() {\n \t\tline := scanner.Bytes()\n \t\tif len(line) == 0 {\n \t\t\tcontinue\n \t\t}\n \n \t\tif lineNum == 0 {\n \t\t\tif err := json.Unmarshal(line, &header); err != nil {\n \t\t\t\treturn nil, nil, fmt.Errorf(\"%w: malformed header: %v\", ErrIndexCorrupt, err)\n \t\t\t}\n \t\t\tif header.Version > CurrentIndexVersion {\n \t\t\t\treturn nil, nil, ErrIndexVersionNewer\n \t\t\t}\n \t\t\tif header.Version < CurrentIndexVersion {\n \t\t\t\treturn nil, nil, fmt.Errorf(\"%w: version %d < %d\", ErrIndexCorrupt, header.Version, CurrentIndexVersion)\n \t\t\t}\n \t\t} else {\n \t\t\tvar entry PromptEntry\n \t\t\tif err := json.Unmarshal(line, &entry); err != nil {\n \t\t\t\treturn nil, nil, fmt.Errorf(\"%w: line %d: %v\", ErrIndexCorrupt, lineNum+1, err)\n \t\t\t}\n \t\t\tentries = append(entries, entry)\n \t\t}\n \t\tlineNum++\n \t}\n \n \tif err := scanner.Err(); err != nil {\n \t\treturn nil, nil, fmt.Errorf(\"reading index: %w\", err)\n \t}\n \n \tif lineNum == 0 {\n \t\treturn nil, nil, ErrIndexEmpty\n \t}\n \n \treturn &header, entries, nil\n }\n \n func (s *IndexStore) AppendEntry(entry PromptEntry) error {\n \tif err := os.MkdirAll(filepath.Dir(s.indexPath), 0o755); err != nil {\n \t\treturn fmt.Errorf(\"creating index directory: %w\", err)\n \t}\n \n \tlock, err := newLockFile(s.lockPath)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"creating lock: %w\", err)\n \t}\n \tdefer lock.Unlock()\n \n \tif err := lock.TryLock(); err != nil {\n \t\treturn s.appendWithRetry(entry, 3)\n \t}\n \n \treturn s.appendLine(entry)\n }\n \n func (s *IndexStore) appendLine(entry PromptEntry) error {\n \tdata, err := json.Marshal(entry)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"marshaling entry: %w\", err)\n \t}\n \n \tf, err := os.OpenFile(s.indexPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"opening index for append: %w\", err)\n \t}\n \tdefer f.Close()\n \n \tif _, err := f.Write(append(data, '\\n')); err != nil {\n \t\treturn fmt.Errorf(\"appending to index: %w\", err)\n \t}\n \treturn nil\n }\n \n func (s *IndexStore) appendWithRetry(entry PromptEntry, maxRetries int) error {\n \tvar lastErr error\n \tfor i := 0; i < maxRetries; i++ {\n \t\ttime.Sleep(50 * time.Millisecond)\n \n \t\tlock, err := newLockFile(s.lockPath)\n \t\tif err != nil {\n \t\t\tlastErr = err\n \t\t\tcontinue\n \t\t}\n \t\tdefer lock.Unlock()\n \n \t\tif err := lock.TryLock(); err != nil {\n \t\t\tlastErr = err\n \t\t\tcontinue\n \t\t}\n \n \t\tif err := s.appendLine(entry); err != nil {\n \t\t\tlastErr = err\n \t\t\tcontinue\n \t\t}\n \t\treturn nil\n \t}\n \treturn fmt.Errorf(\"failed to acquire lock after %d retries: %w\", maxRetries, lastErr)\n }\n \n func (s *IndexStore) InitIndex() error {\n \tif err := os.MkdirAll(filepath.Dir(s.indexPath), 0o755); err != nil {\n \t\treturn fmt.Errorf(\"creating index directory: %w\", err)\n \t}\n \n \theader := IndexHeader{\n \t\tVersion:   CurrentIndexVersion,\n \t\tCreatedAt: time.Now(),\n \t\tRepoRoot:  s.repoRoot,\n \t}\n \n \tdata, err := json.Marshal(header)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"marshaling header: %w\", err)\n \t}\n \n \tif err := os.WriteFile(s.indexPath, append(data, '\\n'), 0o644); err != nil {\n \t\treturn fmt.Errorf(\"writing index header: %w\", err)\n \t}\n \n \treturn nil\n }\n \n func (s *IndexStore) Delete() error {\n \tif s.Exists() {\n \t\tif err := os.Remove(s.indexPath); err != nil {\n \t\t\treturn fmt.Errorf(\"deleting index: %w\", err)\n \t\t}\n \t}\n \tif _, err := os.Stat(s.lockPath); err == nil {\n \t\tif err := os.Remove(s.lockPath); err != nil {\n \t\t\treturn fmt.Errorf(\"deleting lock: %w\", err)\n \t\t}\n \t}\n \treturn nil\n }\n \n func (s *IndexStore) WriteAll(header IndexHeader, entries []PromptEntry) error {\n \tif err := os.MkdirAll(filepath.Dir(s.indexPath), 0o755); err != nil {\n \t\treturn fmt.Errorf(\"creating index directory: %w\", err)\n \t}\n \n \ttmpPath := s.indexPath + \".tmp\"\n \tf, err := os.Create(tmpPath)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"creating temp index: %w\", err)\n \t}\n \tdefer f.Close()\n \n \theader.CreatedAt = time.Now()\n \theader.RepoRoot = s.repoRoot\n \n \theaderData, err := json.Marshal(header)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"marshaling header: %w\", err)\n \t}\n \tif _, err := f.Write(append(headerData, '\\n')); err != nil {\n \t\treturn fmt.Errorf(\"writing header: %w\", err)\n \t}\n \n \tfor _, entry := range entries {\n \t\tentryData, err := json.Marshal(entry)\n \t\tif err != nil {\n \t\t\treturn fmt.Errorf(\"marshaling entry: %w\", err)\n \t\t}\n \t\tif _, err := f.Write(append(entryData, '\\n')); err != nil {\n \t\t\treturn fmt.Errorf(\"writing entry: %w\", err)\n \t\t}\n \t}\n \n \tif err := f.Close(); err != nil {\n \t\treturn fmt.Errorf(\"closing temp index: %w\", err)\n \t}\n \n \tif err := os.Rename(tmpPath, s.indexPath); err != nil {\n \t\treturn fmt.Errorf(\"renaming temp index: %w\", err)\n \t}\n \n \treturn nil\n }\n \n func (s *IndexStore) Stats(ctx context.Context) (IndexStats, error) {\n \t_, entries, err := s.Load(ctx)\n \tif err != nil {\n \t\tif errors.Is(err, ErrIndexMissing) || errors.Is(err, ErrIndexEmpty) {\n \t\t\treturn IndexStats{\n \t\t\t\tIndexPath: s.indexPath,\n \t\t\t\tVersion:   CurrentIndexVersion,\n \t\t\t\tExists:    s.Exists(),\n \t\t\t}, nil\n \t\t}\n \t\treturn IndexStats{}, err\n \t}\n \n \tcpIDs := make(map[string]bool)\n \tfor _, e := range entries {\n \t\tcpIDs[e.CheckpointID] = true\n \t}\n \n \treturn IndexStats{\n-\t\tIndexPath:        s.indexPath,\n-\t\tVersion:          CurrentIndexVersion,\n+\t\tIndexPath:       s.indexPath,\n+\t\tVersion:         CurrentIndexVersion,\n \t\tCheckpointCount: len(cpIDs),\n \t\tPromptCount:     len(entries),\n \t\tEmptyCount:      countEmptyPrompts(entries),\n \t\tFileSize:        fileSize(s.indexPath),\n-\t\tLastUpdated:      time.Now(),\n+\t\tLastUpdated:     time.Now(),\n \t\tExists:          true,\n \t}, nil\n }\n \n type IndexStats struct {\n-\tIndexPath        string\n-\tVersion          int\n-\tCheckpointCount  int\n-\tPromptCount      int\n-\tEmptyCount       int\n-\tFileSize         int64\n-\tLastUpdated      time.Time\n-\tExists           bool\n+\tIndexPath       string\n+\tVersion         int\n+\tCheckpointCount int\n+\tPromptCount     int\n+\tEmptyCount      int\n+\tFileSize        int64\n+\tLastUpdated     time.Time\n+\tExists          bool\n }\n \n func (s *IndexStore) Verify(ctx context.Context, checkpointExists func(ctx context.Context, cpID string) (bool, error)) (VerifyResult, error) {\n \t_, entries, err := s.Load(ctx)\n \tif err != nil {\n \t\treturn VerifyResult{}, err\n \t}\n \n \tvar orphans []string\n \tfor _, e := range entries {\n \t\texists, err := checkpointExists(ctx, e.CheckpointID)\n \t\tif err != nil {\n \t\t\treturn VerifyResult{}, err\n \t\t}\n \t\tif !exists {\n \t\t\torphans = append(orphans, e.CheckpointID)\n \t\t}\n \t}\n \n \treturn VerifyResult{\n \t\tTotalEntries: len(entries),\n-\t\tOrphanCount: len(orphans),\n-\t\tOrphanIDs:   orphans,\n+\t\tOrphanCount:  len(orphans),\n+\t\tOrphanIDs:    orphans,\n \t}, nil\n }\n \n type VerifyResult struct {\n \tTotalEntries int\n \tOrphanCount  int\n \tOrphanIDs    []string\n }\n \n func countEmptyPrompts(entries []PromptEntry) int {\n \tcount := 0\n \tfor _, e := range entries {\n \t\tif strings.TrimSpace(e.PromptText) == \"\" {\n \t\t\tcount++\n \t\t}\n \t}\n \treturn count\n }\n \n func fileSize(path string) int64 {\n \tinfo, err := os.Stat(path)\n \tif err != nil {\n \t\treturn 0\n \t}\n \treturn info.Size()\n }\n \n func SortEntriesByTime(entries []PromptEntry) {\n \tsort.Slice(entries, func(i, j int) bool {\n \t\treturn entries[j].CreatedAt.Before(entries[i].CreatedAt)\n \t})\n }\n \n var checkpointIDPrefixRegex = regexp.MustCompile(`^[0-9a-f]{4,12}`)\n \n func ParseCheckpointIDPrefix(prefix string) string {\n \tprefix = strings.TrimSpace(prefix)\n \tmatches := checkpointIDPrefixRegex.FindString(prefix)\n \tif len(matches) < 4 {\n \t\treturn \"\"\n \t}\n \treturn matches\n }\n \n func FormatFileSize(bytes int64) string {\n \tif bytes < 1024 {\n \t\treturn strconv.FormatInt(bytes, 10) + \" B\"\n \t}\n \tif bytes < 1024*1024 {\n \t\treturn fmt.Sprintf(\"%.1f KB\", float64(bytes)/1024)\n \t}\n \treturn fmt.Sprintf(\"%.1f MB\", float64(bytes)/(1024*1024))\n }\n \n type fileLock struct {\n \tpath string\n \tfile *os.File\n }\n \n func newLockFile(path string) (*fileLock, error) {\n \treturn &fileLock{path: path}, nil\n }\n \n func (l *fileLock) TryLock() error {\n \tdir := filepath.Dir(l.path)\n \tif err := os.MkdirAll(dir, 0o755); err != nil {\n \t\treturn err\n \t}\n \n \tvar err error\n \tl.file, err = os.OpenFile(l.path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o644)\n \tif err != nil {\n \t\tif os.IsExist(err) {\n \t\t\treturn errors.New(\"lock file already exists\")\n \t\t}\n \t\treturn err\n \t}\n \treturn nil\n }\n \n func (l *fileLock) Unlock() error {\n \tif l.file != nil {\n \t\tl.file.Close()\n \t\tl.file = nil\n \t}\n \tos.Remove(l.path)\n \treturn nil\n-}\n\\ No newline at end of file\n+}\n",
