n87: \t// Checkpoints are stored at sharded paths: <id[:2]>/<id[2:]>/\n88: \tWriteCommitted(ctx context.Context, opts WriteCommittedOptions) error\n89: \n90: \t// ReadCommitted reads a committed checkpoint's summary by ID.\n91: \t// Returns only the CheckpointSummary (paths + aggregated stats), not actual content.\n92: \t// Use ReadSessionContent to read actual transcript/prompts.\n93: \t// Returns nil, nil if the checkpoint does not exist.\n94: \tReadCommitted(ctx context.Context, checkpointID id.CheckpointID) (*CheckpointSummary, error)\n95: \n96: \t// ReadSessionContent reads the actual content for a specific session within a checkpoint.\n97: \t// sessionIndex is 0-based (0 for first session, 1 for second, etc.).\n98: \t// Returns the session's metadata, transcript, and prompts.\n99: \tReadSessionContent(ctx context.Context, checkpointID id.CheckpointID, sessionIndex int) (*SessionContent, error)\n100: \n101: \t// ReadSessionContentByID reads a session's content by its session ID.\n102: \t// Useful when you have the session ID but don't know its index within the checkpoint.\n103: \tReadSessionContentByID(ctx context.Context, checkpointID id.CheckpointID, sessionID string) (*SessionContent, error)\n104: \n105: \t// ListCommitted lists all committed checkpoints.\n106: \tListCommitted(ctx context.Context) ([]CommittedInfo, error)\n107: \n108: \t// UpdateCommitted replaces the transcript and prompts for an existing\n109: \t// committed checkpoint. Used at stop time to finalize checkpoints with the full\n110: \t// session transcript (prompt to stop event).\n111: \t// Returns ErrCheckpointNotFound if the checkpoint doesn't exist.\n112: \tUpdateCommitted(ctx context.Context, opts UpdateCommittedOptions) error\n113: }\n114: \n115: // WriteTemporaryResult contains the result of writing a temporary checkpoint.\n116: type WriteTemporaryResult struct {\n117: \t// CommitHash is the hash of the created or existing checkpoint commit\n118: \tCommitHash plumbing.Hash\n119: \n120: \t// Skipped is true if the checkpoint was skipped due to no changes\n121: \t// (tree hash matched the previous checkpoint)\n122: \tSkipped bool\n123: }\n124: \n125: // WriteTemporaryOptions contains options for writing a temporary checkpoint.\n126: type WriteTemporaryOptions struct {\n127: \t// SessionID is the session identifier\n128: \tSessionID string\n129: \n130: \t// BaseCommit is the commit hash this session is based on\n131: \tBaseCommit string\n132: \n133: \t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n134: \t// Used to create worktree-specific shadow branch names\n135: \tWorktreeID string\n136: \n137: \t// ModifiedFiles are files that have been modified (relative paths)\n138: \tModifiedFiles []string\n139: \n140: \t// NewFiles are files that have been created (relative paths)\n141: \tNewFiles []string\n142: \n143: \t// DeletedFiles are files that have been deleted (relative paths)\n144: \tDeletedFiles []string\n145: \n146: \t// MetadataDir is the relative path to the metadata directory\n147: \tMetadataDir string\n148: \n149: \t// MetadataDirAbs is the absolute path to the metadata directory\n150: \tMetadataDirAbs string\n151: \n152: \t// CommitMessage is the commit subject line\n153: \tCommitMessage string\n154: \n155: \t// AuthorName is the name to use for commits\n156: \tAuthorName string\n157: \n158: \t// AuthorEmail is the email to use for commits\n159: \tAuthorEmail string\n160: \n161: \t// IsFirstCheckpoint indicates if this is the first checkpoint of the session\n162: \t// When true, all working directory files are captured (not just modified)\n163: \tIsFirstCheckpoint bool\n164: }\n165: \n166: // ReadTemporaryResult contains the result of reading a temporary checkpoint.\n167: type ReadTemporaryResult struct {\n168: \t// CommitHash is the hash of the checkpoint commit\n169: \tCommitHash plumbing.Hash\n170: \n171: \t// TreeHash is the hash of the tree containing the checkpoint state\n172: \tTreeHash plumbing.Hash\n173: \n174: \t// SessionID is the session identifier from the commit trailer\n175: \tSessionID string\n176: \n177: \t// MetadataDir is the metadata directory path from the commit trailer\n178: \tMetadataDir string\n179: \n180: \t// Timestamp is when the checkpoint was created\n181: \tTimestamp time.Time\n182: }\n183: \n184: // TemporaryInfo contains summary information about a shadow branch.\n185: type TemporaryInfo struct {\n186: \t// BranchName is the full branch name (e.g., \"entire/abc1234\")\n187: \tBranchName string\n188: \n189: \t// BaseCommit is the short commit hash this branch is based on\n190: \tBaseCommit string\n191: \n192: \t// LatestCommit is the hash of the latest commit on the branch\n193: \tLatestCommit plumbing.Hash\n194: \n195: \t// SessionID is the session identifier from the latest commit\n196: \tSessionID string\n197: \n198: \t// Timestamp is when the latest checkpoint was created\n199: \tTimestamp time.Time\n200: }\n201: \n202: // WriteCommittedOptions contains options for writing a committed checkpoint.\n203: type WriteCommittedOptions struct {\n204: \t// CheckpointID is the stable 12-hex-char identifier\n205: \tCheckpointID id.CheckpointID\n206: \n207: \t// SessionID is the session identifier\n208: \tSessionID string\n209: \n210: \t// CreatedAt is when the checkpoint was originally created.\n211: \t// When zero, writers use the current time. Migration sets this to preserve\n212: \t// the original v1 checkpoint time in v2 metadata and retention decisions.\n213: \tCreatedAt time.Time\n214: \n215: \t// Strategy is the name of the strategy that created this checkpoint\n216: \tStrategy string\n217: \n218: \t// Branch is the branch name where the checkpoint was created (empty if detached HEAD)\n219: \tBranch string\n220: \n221: \t// Transcript is the session transcript content (full.jsonl).\n222: \t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n223: \tTranscript redact.RedactedBytes\n224: \n225: \t// Prompts contains user prompts from the session\n226: \tPrompts []string\n227: \n228: \t// FilesTouched are files modified during the session\n229: \tFilesTouched []string\n230: \n231: \t// CheckpointsCount is the number of checkpoints in this session\n232: \tCheckpointsCount int\n233: \n234: \t// EphemeralBranch is the shadow branch name (for manual-commit strategy)\n235: \tEphemeralBranch string\n236: \n237: \t// AuthorName is the name to use for commits\n238: \tAuthorName string\n239: \n240: \t// AuthorEmail is the email to use for commits\n241: \tAuthorEmail string\n242: \n243: \t// MetadataDir is a directory containing additional metadata files to copy\n244: \t// If set, all files in this directory will be copied to the checkpoint path\n245: \t// This is useful for copying task metadata files, subagent transcripts, etc.\n246: \tMetadataDir string\n247: \n248: \t// Task checkpoint fields (for task/subagent checkpoints)\n249: \tIsTask    bool   // Whether this is a task checkpoint\n250: \tToolUseID string // Tool use ID for task checkpoints\n251: \n252: \t// Additional task checkpoint fields for subagent checkpoints\n253: \tAgentID                string // Subagent identifier\n254: \tCheckpointUUID         string // UUID for transcript truncation when rewinding\n255: \tTranscriptPath         string // Path to session transcript file (alternative to in-memory Transcript)\n256: \tSubagentTranscriptPath string // Path to subagent's transcript file\n257: \n258: \t// Incremental checkpoint fields\n259: \tIsIncremental       bool   // Whether this is an incremental checkpoint\n260: \tIncrementalSequence int    // Checkpoint sequence number\n261: \tIncrementalType     string // Tool type that triggered this checkpoint\n262: \tIncrementalData     []byte // Tool input payload for this checkpoint\n263: \n264: \t// Commit message fields (used for task checkpoints)\n265: \tCommitSubject string // Subject line for the metadata commit (overrides default)\n266: \n267: \t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n268: \tAgent types.AgentType\n269: \n270: \t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\")\n271: \tModel string\n272: \n273: \t// TurnID correlates checkpoints from the same agent turn.\n274: \tTurnID string\n275: \n276: \t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n277: \tTranscriptIdentifierAtStart string // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n278: \tCheckpointTranscriptStart   int    // Transcript line offset at start of this checkpoint's data\n279: \n280: \t// CheckpointTranscriptStart is written to both CommittedMetadata.CheckpointTranscriptStart\n281: \t// and the deprecated CommittedMetadata.TranscriptLinesAtStart for backward compatibility.\n282: \n283: \t// CompactTranscriptStart is the transcript.jsonl line offset at checkpoint start.\n284: \t// V2 /main writes this to checkpoint_transcript_start; v1 continues to use\n285: \t// CheckpointTranscriptStart (full.jsonl).\n286: \tCompactTranscriptStart int\n287: \n288: \t// TokenUsage contains the token usage for this checkpoint\n289: \tTokenUsage *agent.TokenUsage\n290: \n291: \t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage)\n292: \tSessionMetrics *SessionMetrics\n293: \n294: \t// InitialAttribution is line-level attribution calculated at commit time\n295: \t// comparing checkpoint tree (agent work) to committed tree (may include human edits)\n296: \tInitialAttribution *InitialAttribution\n297: \n298: \t// PromptAttributionsJSON is the raw PromptAttributions data, JSON-encoded.\n299: \t// Persisted for diagnostic purposes — shows exactly which prompt recorded\n300: \t// which \"user\" lines, enabling root cause analysis of attribution bugs.\n301: \t// Uses json.RawMessage to avoid importing session package.\n302: \tPromptAttributionsJSON json.RawMessage\n303: \n304: \t// CombinedAttribution is holistic attribution across all sessions.\n305: \t// Used during migration to preserve v1 root summary attribution.\n306: \t// During normal condensation this is nil (computed post-commit via UpdateCheckpointSummary).\n307: \tCombinedAttribution *InitialAttribution\n308: \n309: \t// Summary is an optional AI-generated summary for this checkpoint.\n310: \t// This field may be nil when:\n311: \t//   - summarization is disabled in settings\n312: \t//   - summary generation failed (non-blocking, logged as warning)\n313: \t//   - the transcript was empty or too short to summarize\n314: \t//   - the checkpoint predates the summarization feature\n315: \tSummary *Summary\n316: \n317: \t// CompactTranscript is the Entire Transcript Format (transcript.jsonl) bytes.\n318: \t// Written to v2 /main ref alongside metadata. May be nil if compaction\n319: \t// was not performed (unknown agent, compaction error, empty transcript).\n320: \tCompactTranscript []byte\n321: \n322: \t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n323: \tKind string\n324: \n325: \t// ReviewSkills is the snapshot of skills used (only meaningful when Kind is a review kind).\n326: \t// May be empty when a review is attached post-hoc without declared skills.\n327: \tReviewSkills []string\n328: \n329: \t// ReviewPrompt is the actual text of the review request (composed prompt\n330: \t// for spawn, first user prompt for attach). Only meaningful when Kind is\n331: \t// a review kind.\n332: \tReviewPrompt string\n333: \n334: \t// HasReview is set by the caller when this session should mark its\n335: \t// checkpoint as reviewed. The caller computes this (e.g. via\n336: \t// session.Kind.IsReview) because checkpoint can't import session\n337: \t// — the session package imports checkpoint, creating a cycle.\n338: \tHasReview bool\n339: }\n340: \n341: // UpdateCommittedOptions contains options for updating an existing committed checkpoint.\n342: // Uses replace semantics: the transcript and prompts are fully replaced,\n343: // not appended. At stop time we have the complete session transcript and want every\n344: // checkpoint to contain it identically.\n345: type UpdateCommittedOptions struct {\n346: \t// CheckpointID identifies the checkpoint to update\n347: \tCheckpointID id.CheckpointID\n348: \n349: \t// SessionID identifies which session slot to update within the checkpoint\n350: \tSessionID string\n351: \n352: \t// Transcript is the full session transcript (replaces existing).\n353: \t// Must be pre-redacted (via redact.JSONLBytes or redact.AlreadyRedacted for trusted sources).\n354: \tTranscript redact.RedactedBytes\n355: \n356: \t// Prompts contains all user prompts (replaces existing)\n357: \tPrompts []string\n358: \n359: \t// Agent identifies the agent type (needed for transcript chunking)\n360: \tAgent types.AgentType\n361: \n362: \t// CompactTranscript is the updated Entire Transcript Format bytes.\n363: \t// If non-nil, replaces the existing transcript.jsonl on v2 /main.\n364: \tCompactTranscript []byte\n365: \n366: \t// PrecomputedBlobs, if non-nil, provides chunk blob hashes and the\n367: \t// content-hash blob hash computed once for this transcript. When set,\n368: \t// UpdateCommitted skips the per-call ChunkTranscript + zlib work and\n369: \t// reuses these hashes. Used by finalizeAllTurnCheckpoints to avoid\n370: \t// re-compressing identical content N times.\n371: \tPrecomputedBlobs *PrecomputedTranscriptBlobs\n372: }\n373: \n374: // PrecomputedTranscriptBlobs holds blob hashes for a transcript that was\n375: // chunked and written to the object store once, for reuse across multiple\n376: // UpdateCommitted calls sharing the same transcript content.\n377: //\n378: // Blob hashes are content-addressed (SHA-1 of chunk bytes), so the same\n379: // PrecomputedTranscriptBlobs works for both v1 (full.jsonl) and v2\n380: // (raw_transcript) paths — only the tree-entry filename differs.\n381: //\n382: // Callers should avoid constructing this for empty transcripts; agent.ChunkTranscript\n383: // would otherwise produce a single zero-length chunk and a hash for an empty\n384: // blob, which downstream stores would never reference.\n385: type PrecomputedTranscriptBlobs struct {\n386: \t// ChunkHashes are the blob hashes for each transcript chunk, in order.\n387: \t// Always non-empty when built via PrecomputeTranscriptBlobs (a non-empty\n388: \t// transcript chunks to at least one entry; callers should skip precompute\n389: \t// for empty transcripts).\n390: \tChunkHashes []plumbing.Hash\n391: \n392: \t// ContentHashBlob is the blob hash of the \"sha256:<hex>\" content-hash\n393: \t// string for the transcript.\n394: \tContentHashBlob plumbing.Hash\n395: \n396: \t// ContentHash is the \"sha256:<hex>\" string itself, so the short-circuit\n397: \t// path can compare without re-reading the blob.\n398: \tContentHash string\n399: }\n400: \n401: // isUsable reports whether the precomputed blobs satisfy the invariants that\n402: // consumers depend on: a non-zero content-hash blob and at least one chunk\n403: // hash. Callers should fall back to the fresh-write path when this is false.\n404: func (p *PrecomputedTranscriptBlobs) isUsable() bool {\n405: \treturn p != nil && !p.ContentHashBlob.IsZero() && len(p.ChunkHashes) > 0\n406: }\n407: \n408: // CommittedInfo contains summary information about a committed checkpoint.\n409: type CommittedInfo struct {\n410: \t// CheckpointID is the stable 12-hex-char identifier\n411: \tCheckpointID id.CheckpointID\n412: \n413: \t// SessionID is the session identifier (most recent session for multi-session checkpoints)\n414: \tSessionID string\n415: \n416: \t// CreatedAt is when the checkpoint was created\n417: \tCreatedAt time.Time\n418: \n419: \t// CheckpointsCount is the total number of checkpoints across all sessions\n420: \tCheckpointsCount int\n421: \n422: \t// FilesTouched are files modified during all sessions\n423: \tFilesTouched []string\n424: \n425: \t// Agent identifies the agent that created this checkpoint\n426: \tAgent types.AgentType\n427: \n428: \t// IsTask indicates if this is a task checkpoint\n429: \tIsTask bool\n430: \n431: \t// ToolUseID is the tool use ID for task checkpoints\n432: \tToolUseID string\n433: \n434: \t// Multi-session support\n435: \tSessionCount int      // Number of sessions (1 if single session)\n436: \tSessionIDs   []string // All session IDs that contributed\n437: }\n438: \n439: // SessionContent contains the actual content for a session.\n440: // This is used when reading full session data (transcript, prompts, context)\n441: // as opposed to just the metadata/summary.\n442: type SessionContent struct {\n443: \t// Metadata contains the session-specific metadata\n444: \tMetadata CommittedMetadata\n445: \n446: \t// Transcript is the session transcript content\n447: \tTranscript []byte\n448: \n449: \t// TranscriptBlobHashes are the stored raw transcript blob hashes in chunk\n450: \t// order. Callers that rewrite the same transcript under a different path can\n451: \t// reuse these content-addressed blobs instead of storing duplicate blobs.\n452: \tTranscriptBlobHashes []plumbing.Hash\n453: \n454: \t// Prompts contains user prompts from this session\n455: \tPrompts string\n456: }\n457: \n458: // CommittedMetadata contains the metadata stored in metadata.json for each checkpoint.\n459: type CommittedMetadata struct {\n460: \tCLIVersion       string          `json:\"cli_version,omitempty\"`\n461: \tCheckpointID     id.CheckpointID `json:\"checkpoint_id\"`\n462: \tSessionID        string          `json:\"session_id\"`\n463: \tStrategy         string          `json:\"strategy\"`\n464: \tCreatedAt        time.Time       `json:\"created_at\"`\n465: \tBranch           string          `json:\"branch,omitempty\"` // Branch where checkpoint was created (empty if detached HEAD)\n466: \tCheckpointsCount int             `json:\"checkpoints_count\"`\n467: \tFilesTouched     []string        `json:\"files_touched\"`\n468: \n469: \t// Agent identifies the agent that created this checkpoint (e.g., \"Claude Code\", \"Cursor\")\n470: \tAgent types.AgentType `json:\"agent,omitempty\"`\n471: \n472: \t// Model is the LLM model used during the session (e.g., \"claude-sonnet-4-20250514\").\n473: \t// Always written to metadata (empty string when unknown) so consumers can rely on the field's presence.\n474: \tModel string `json:\"model\"`\n475: \n476: \t// TurnID correlates checkpoints from the same agent turn.\n477: \t// When a turn's work spans multiple commits, each gets its own checkpoint\n478: \t// but they share the same TurnID for future aggregation/deduplication.\n479: \tTurnID string `json:\"turn_id,omitempty\"`\n480: \n481: \t// Task checkpoint fields (only populated for task checkpoints)\n482: \tIsTask    bool   `json:\"is_task,omitempty\"`\n483: \tToolUseID string `json:\"tool_use_id,omitempty\"`\n484: \n485: \t// Transcript position at checkpoint start - tracks what was added during this checkpoint\n486: \tTranscriptIdentifierAtStart string `json:\"transcript_identifier_at_start,omitempty\"` // Last identifier when checkpoint started (UUID for Claude, message ID for Gemini)\n487: \tCheckpointTranscriptStart   int    `json:\"checkpoint_transcript_start,omitempty\"`    // Transcript line offset at start of this checkpoint's data\n488: \n489: \t// Deprecated: Use CheckpointTranscriptStart instead. Written for backward compatibility with older CLI versions.\n490: \tTranscriptLinesAtStart int `json:\"transcript_lines_at_start,omitempty\"`\n491: \n492: \t// Token usage for this checkpoint\n493: \tTokenUsage *agent.TokenUsage `json:\"token_usage,omitempty\"`\n494: \n495: \t// SessionMetrics contains hook-provided session metrics (duration, turns, context usage).\n496: \t// Populated for agents that provide these metrics via hooks (e.g., Cursor).\n497: \tSessionMetrics *SessionMetrics `json:\"session_metrics,omitempty\"`\n498: \n499: \t// AI-generated summary of the checkpoint\n500: \tSummary *Summary `json:\"summary,omitempty\"`\n501: \n502: \t// InitialAttribution is line-level attribution calculated at commit time\n503: \tInitialAttribution *InitialAttribution `json:\"initial_attribution,omitempty\"`\n504: \n505: \t// PromptAttributions is the raw per-prompt attribution data used to compute InitialAttribution.\n506: \t// Diagnostic field — shows which prompt recorded which \"user\" lines.\n507: \tPromptAttributions json.RawMessage `json:\"prompt_attributions,omitempty\"`\n508: \n509: \t// Kind identifies the session purpose (e.g., \"agent_review\"). Empty for normal sessions.\n510: \tKind string `json:\"kind,omitempty\"`\n511: \n512: \t// ReviewSkills lists the review skills that were run (only set when Kind is a review kind).\n513: \t// May be empty when a review was attached post-hoc without declared skills.\n514: \tReviewSkills []string `json:\"review_skills,omitempty\"`\n515: \n516: \t// ReviewPrompt is the actual text of the review request (composed prompt\n517: \t// for spawn, first user prompt for attach). Only set when Kind is a\n518: \t// review kind.\n519: \tReviewPrompt string `json:\"review_prompt,omitempty\"`\n520: }\n521: \n522: // GetTranscriptStart returns the transcript line offset at which this checkpoint's data begins.\n523: // Returns 0 for new checkpoints (start from beginning). For data written by older CLI versions,\n524: // falls back to the deprecated TranscriptLinesAtStart field.\n525: func (m CommittedMetadata) GetTranscriptStart() int {\n526: \tif m.CheckpointTranscriptStart > 0 {\n527: \t\treturn m.CheckpointTranscriptStart\n528: \t}\n529: \treturn m.TranscriptLinesAtStart\n530: }\n531: \n532: // SessionFilePaths contains the absolute paths to session files from the git tree root.\n533: // Paths include the full checkpoint path prefix (e.g., \"/a1/b2c3d4e5f6/1/metadata.json\").\n534: // Used in CheckpointSummary.Sessions to map session IDs to their file locations.\n535: type SessionFilePaths struct {\n536: \tMetadata    string `json:\"metadata\"`\n537: \tTranscript  string `json:\"transcript,omitempty\"`\n538: \tContentHash string `json:\"content_hash,omitempty\"`\n539: \tPrompt      string `json:\"prompt\"`\n540: }\n541: \n542: // CheckpointSummary is the root-level metadata.json for a checkpoint.\n543: // It contains aggregated statistics from all sessions and a map of session IDs\n544: // to their file paths. Session-specific data (including initial_attribution)\n545: // is stored in the session's subdirectory metadata.json.\n546: //\n547: // Structure on entire/checkpoints/v1 branch:\n548: //\n549: //\t<checkpoint-id[:2]>/<checkpoint-id[2:]>/\n550: //\t├── metadata.json         # This CheckpointSummary\n551: //\t├── 1/                    # First session\n552: //\t│   ├── metadata.json     # Session-specific CommittedMetadata\n553: //\t│   ├── full.jsonl\n554: //\t│   ├── prompt.txt\n555: //\t│   └── content_hash.txt\n556: //\t├── 2/                    # Second session\n557: //\t└── 3/                    # Third session...\n558: //\n559: //nolint:revive // Named CheckpointSummary to avoid conflict with existing Summary struct\n560: type CheckpointSummary struct {\n561: \tCLIVersion          string              `json:\"cli_version,omitempty\"`\n562: \tCheckpointID        id.CheckpointID     `json:\"checkpoint_id\"`\n563: \tStrategy            string              `json:\"strategy\"`\n564: \tBranch              string              `json:\"branch,omitempty\"`\n565: \tCheckpointsCount    int                 `json:\"checkpoints_count\"`\n566: \tFilesTouched        []string            `json:\"files_touched\"`\n567: \tSessions            []SessionFilePaths  `json:\"sessions\"`\n568: \tTokenUsage          *agent.TokenUsage   `json:\"token_usage,omitempty\"`\n569: \tCombinedAttribution *InitialAttribution `json:\"combined_attribution,omitempty\"`\n570: \n571: \t// HasReview is the umbrella \"any review happened\" flag: true when at least\n572: \t// one session in this checkpoint has a review-kind Kind (currently\n573: \t// \"agent_review\"). When new review kinds are introduced they should also\n574: \t// cause this flag to be set so callers can keep asking \"was this reviewed\n575: \t// in any way?\" without caring about the variant.\n576: \tHasReview bool `json:\"has_review,omitempty\"`\n577: }\n578: \n579: // SessionMetrics contains hook-provided session metrics from agents that report\n580: // them via lifecycle hooks (e.g., Cursor). These supplement transcript-derived\n581: // metrics for agents whose transcripts lack usage/timing data.\n582: type SessionMetrics struct {\n583: \tDurationMs        int64 `json:\"duration_ms,omitempty\"`\n584: \tTurnCount         int   `json:\"turn_count,omitempty\"`\n585: \tContextTokens     int   `json:\"context_tokens,omitempty\"`\n586: \tContextWindowSize int   `json:\"context_window_size,omitempty\"`\n587: }\n588: \n589: // Summary contains AI-generated summary of a checkpoint.\n590: type Summary struct {\n591: \tIntent    string           `json:\"intent\"`     // What user wanted to accomplish\n592: \tOutcome   string           `json:\"outcome\"`    // What was achieved\n593: \tLearnings LearningsSummary `json:\"learnings\"`  // Categorized learnings\n594: \tFriction  []string         `json:\"friction\"`   // Problems/annoyances encountered\n595: \tOpenItems []string         `json:\"open_items\"` // Tech debt, unfinished work\n596: }\n597: \n598: // LearningsSummary contains learnings grouped by scope.\n599: type LearningsSummary struct {\n600: \tRepo     []string       `json:\"repo\"`     // Codebase-specific patterns/conventions\n601: \tCode     []CodeLearning `json:\"code\"`     // File/module specific findings\n602: \tWorkflow []string       `json:\"workflow\"` // General dev practices\n603: }\n604: \n605: // CodeLearning captures a learning tied to a specific code location.\n606: type CodeLearning struct {\n607: \tPath    string `json:\"path\"`               // File path\n608: \tLine    int    `json:\"line,omitempty\"`     // Start line number\n609: \tEndLine int    `json:\"end_line,omitempty\"` // End line for ranges (optional)\n610: \tFinding string `json:\"finding\"`            // What was learned\n611: }\n612: \n613: // InitialAttribution captures line-level attribution metrics at commit time.\n614: // This is a point-in-time snapshot comparing the checkpoint tree (agent work)\n615: // against the committed tree (may include human edits).\n616: //\n617: // Attribution Metrics:\n618: //   - TotalCommitted keeps the historical \"net additions\" view for compatibility\n619: //   - TotalLinesChanged measures total committed line changes (adds + modifies + removes)\n620: //   - AgentPercentage represents \"of the lines changed in this commit, what percentage came from the agent\"\n621: //   - AgentRemoved tracks committed deletions performed by the agent\n622: type InitialAttribution struct {\n623: \tCalculatedAt      time.Time `json:\"calculated_at\"`\n624: \tAgentLines        int       `json:\"agent_lines\"`              // Lines added by agent that remain in the commit\n625: \tAgentRemoved      int       `json:\"agent_removed\"`            // Lines removed by agent that remain removed in the commit\n626: \tHumanAdded        int       `json:\"human_added\"`              // Lines added by human (excluding modifications)\n627: \tHumanModified     int       `json:\"human_modified\"`           // Lines modified by human (estimate: min(added, removed))\n628: \tHumanRemoved      int       `json:\"human_removed\"`            // Lines removed by human (excluding modifications)\n629: \tTotalCommitted    int       `json:\"total_committed\"`          // Net additions in commit (legacy additions-focused metric)\n630: \tTotalLinesChanged int       `json:\"total_lines_changed\"`      // Total committed line changes (adds + modifies + removes)\n631: \tAgentPercentage   float64   `json:\"agent_percentage\"`         // (agent_lines + agent_removed) / total_lines_changed * 100\n632: \tMetricVersion     int       `json:\"metric_version,omitempty\"` // 0/absent = legacy (additions-only %), 2 = changed-lines %\n633: }\n634: \n635: // Info provides summary information for listing checkpoints.\n636: // This is the generic checkpoint info type.\n637: type Info struct {\n638: \t// ID is the checkpoint identifier\n639: \tID string\n640: \n641: \t// SessionID identifies the session\n642: \tSessionID string\n643: \n644: \t// Type indicates temporary or committed\n645: \tType Type\n646: \n647: \t// CreatedAt is when the checkpoint was created\n648: \tCreatedAt time.Time\n649: \n650: \t// Message is a summary description\n651: \tMessage string\n652: }\n653: \n654: // WriteTemporaryTaskOptions contains options for writing a task checkpoint.\n655: // Task checkpoints are created when a subagent completes and contain both\n656: // code changes and task-specific metadata.\n657: type WriteTemporaryTaskOptions struct {\n658: \t// SessionID is the session identifier\n659: \tSessionID string\n660: \n661: \t// BaseCommit is the commit hash this session is based on\n662: \tBaseCommit string\n663: \n664: \t// WorktreeID is the internal git worktree identifier (empty for main worktree)\n665: \t// Used to create worktree-specific shadow branch names\n666: \tWorktreeID string\n667: \n668: \t// ToolUseID is the unique identifier for this Task tool invocation\n669: \tToolUseID string\n670: \n671: \t// AgentID is the subagent identifier\n672: \tAgentID string\n673: \n674: \t// ModifiedFiles are files that have been modified (relative paths)\n675: \tModifiedFiles []string\n676: \n677: \t// NewFiles are files that have been created (relative paths)\n678: \tNewFiles []string\n679: \n680: \t// DeletedFiles are files that have been deleted (relative paths)\n681: \tDeletedFiles []string\n682: \n683: \t// TranscriptPath is the path to the main session transcript\n684: \tTranscriptPath string\n685: \