            "output": "<path>/Users/aasheesh/Documents/webdev/os/cli/cmd/entire/cli/agent/pi/pi.go</path>\n<type>file</type>\n<content>\n1: // Package pi implements the Agent interface for the pi coding agent\n2: // (https://github.com/earendil-works/pi-mono).\n3: // The npm package the embedded extension imports a type from is\n4: // `@earendil-works/pi-coding-agent`.\n5: //\n6: // This is an in-tree port of the previously-external entire-agent-pi plugin\n7: // (github.com/entireio/external-agents/agents/entire-agent-pi). The behaviour\n8: // matches the external version — most notably the active-branch resolution\n9: // for Pi's tree-shaped sessions — but the integration is plumbed directly\n10: // through the in-tree Agent / HookSupport / TokenCalculator / TranscriptAnalyzer\n11: // interfaces rather than the external JSON-over-stdio protocol.\n12: package pi\n13: \n14: import (\n15: \t\"context\"\n16: \t\"errors\"\n17: \t\"fmt\"\n18: \t\"os\"\n19: \t\"path/filepath\"\n20: \t\"sort\"\n21: \t\"strings\"\n22: \n23: \t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n24: \t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n25: \t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n26: )\n27: \n28: // piHomeEnvVar overrides the default Pi home directory (~/.pi/agent).\n29: // Pi itself reads this variable, so honoring it keeps Entire and Pi in\n30: // agreement when a developer points Pi at a non-default home.\n31: const piHomeEnvVar = \"PI_CODING_AGENT_DIR\"\n32: \n33: // piSessionDirEnvVar lets tests redirect Pi's session lookup without\n34: // touching the real ~/.pi/agent. Mirrors ENTIRE_TEST_<AGENT>_SESSION_DIR\n35: // used by Codex.\n36: const piSessionDirEnvVar = \"ENTIRE_TEST_PI_SESSION_DIR\"\n37: \n38: //nolint:gochecknoinits // Agent self-registration is the intended pattern\n39: func init() {\n40: \tagent.Register(agent.AgentNamePi, NewPiAgent)\n41: }\n42: \n43: // PiAgent implements agent.Agent for the pi coding agent.\n44: //\n45: //nolint:revive // Pi