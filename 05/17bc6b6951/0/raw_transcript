            "output": "<path>/Users/aasheesh/Documents/webdev/os/cli/cmd/entire/cli/checkpoint/checkpoint.go</path>\n<type>file</type>\n<content>\n1: // Package checkpoint provides types and interfaces for checkpoint storage.\n2: //\n3: // A Checkpoint captures a point-in-time within a session, containing either\n4: // full state (Temporary) or metadata with a commit reference (Committed).\n5: //\n6: // See docs/architecture/sessions-and-checkpoints.md for the full domain model.\n7: package checkpoint\n8: \n9: import (\n10: \t\"context\"\n11: \t\"encoding/json\"\n12: \t\"errors\"\n13: \t\"time\"\n14: \n15: \t\"github.com/entireio/cli/cmd/entire/cli/agent\"\n16: \t\"github.com/entireio/cli/cmd/entire/cli/agent/types\"\n17: \t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n18: \t\"github.com/entireio/cli/redact\"\n19: \n20: \t\"github.com/go-git/go-git/v6/plumbing\"\n21: )\n22: \n23: // Errors returned by checkpoint operations.\n24: var (\n25: \t// ErrCheckpointNotFound is returned when a checkpoint ID doesn't exist.\n26: \tErrCheckpointNotFound = errors.New(\"checkpoint not found\")\n27: \n28: \t// ErrNoTranscript is returned when a checkpoint exists but has no transcript.\n29: \tErrNoTranscript = errors.New(\"no transcript found for checkpoint\")\n30: )\n31: \n32: // Checkpoint represents a save point within a session.\n33: type Checkpoint struct {\n34: \t// ID is the unique checkpoint identifier\n35: \tID string\n36: \n37: \t// SessionID is the session this checkpoint belongs to\n38: \tSessionID string\n39: \n40: \t// Timestamp is when this checkpoint was created\n41: \tTimestamp time.Time\n42: \n43: \t// Type indicates temporary (full state) or committed (metadata only)\n44: \tType Type\n45: \n46: \t// Message is a human-readable description of the checkpoint\n47: \tMessage string\n48: }\n49: \n50: // Type indicates the storage location and lifecycle of a checkpoint.\n51: type Type int\n52: \n53: const (\n54: \t// Temporary checkpoints contain full state