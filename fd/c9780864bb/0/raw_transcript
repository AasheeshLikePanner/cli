 h.committedFileSet, condenseOpts{\n734: \t\t\tshadowRef:        h.shadowRef,\n735: \t\t\theadTree:         h.headTree,\n736: \t\t\tparentTree:       h.parentTree,\n737: \t\t\trepoDir:          h.repoDir,\n738: \t\t\tparentCommitHash: h.parentCommitHash(),\n739: \t\t\theadCommitHash:   h.newHead,\n740: \t\t\tallAgentFiles:    h.allAgentFiles,\n741: \t\t})\n742: \t} else {\n743: \t\th.s.updateBaseCommitIfChanged(h.ctx, state, h.newHead)\n744: \t}\n745: \treturn nil\n746: }\n747: \n748: // shouldCondenseWithOverlapCheck returns true if the session should be condensed\n749: // into this commit. Active sessions with recent interaction condense unless they\n750: // have no tracked files and another session claims the committed files (read-only\n751: // gate). Stale ACTIVE and IDLE/ENDED sessions require file overlap evidence\n752: // between tracked files and committed files.\n753: func (h *postCommitActionHandler) shouldCondenseWithOverlapCheck(isActive bool, lastInteraction *time.Time) bool {\n754: \tif !h.hasNew {\n755: \t\treturn false\n756: \t}\n757: \t// ACTIVE sessions with recent interaction: skip the overlap check.\n758: \t// PrepareCommitMsg already validated this commit is session-related\n759: \t// (added trailer). The overlap check is only meaningful when we need\n760: \t// heuristic evidence that a commit was related to the session.\n761: \t//\n762: \t// Exception: when another session's tracked files overlap with the\n763: \t// committed files, skip this ACTIVE session if it has no tracked files\n764: \t// itself. This prevents read-only sessions (e.g., codex exec from tools\n765: \t// like summarize) from being condensed when a different session's commit\n766: \t// triggers PostCommit. When no other session claims the committed files,\n767: \t// the ACTIVE session is assumed to own the commit.\n768: \t//\n769: \t// We check LastInteractionTime to avoid condensing stale ACTIVE sessions\n770: \t// (agent killed without Stop hook) into every subsequent commit. A stale\n771: \t// session has no recent interaction and falls through to the overlap check.\n772: \tif isActive && isRecentInteraction(lastInteraction) {\n773: \t\tif h.sessionsWithCommittedFiles > 0 && len(h.filesTouchedBefore) == 0 {\n774: \t\t\tlogging.Debug(h.ctx, \"post-commit: skipping read-only ACTIVE session (no tracked files, other sessions claim committed files)\",\n775: \t\t\t\tslog.Int(\"sessions_with_committed_files\", h.sessionsWithCommittedFiles),\n776: \t\t\t)\n777: \t\t\treturn false\n778: \t\t}\n779: \t\treturn true\n780: \t}\n781: \tif len(h.filesTouchedBefore) == 0 {\n782: \t\treturn false // No files tracked = no overlap evidence\n783: \t}\n784: \t// Only check files that were actually changed in this commit.\n785: \t// Without this, files that exist in the tree but weren't changed\n786: \t// would pass the \"modified file\" check in filesOverlapWithContent\n787: \t// (because the file exists in the parent tree), causing stale\n788: \t// sessions to be incorrectly condensed.\n789: \tvar committedTouchedFiles []string\n790: \tfor _, f := range h.filesTouchedBefore {\n791: \t\tif _, ok := h.committedFileSet[f]; ok {\n792: \t\t\tcommittedTouchedFiles = append(committedTouchedFiles, f)\n793: \t\t}\n794: \t}\n795: \tif len(committedTouchedFiles) == 0 {\n796: \t\treturn false\n797: \t}\n798: \treturn filesOverlapWithContent(h.ctx, h.repo, h.shadowBranchName, h.commit, committedTouchedFiles, overlapOpts{\n799: \t\theadTree:      h.headTree,\n800: \t\tshadowTree:    h.shadowTree,\n801: \t\tparentTree:    h.parentTree,\n802: \t\thasParentTree: true,\n803: \t})\n804: }\n805: \n806: const (\n807: \tstaleEndedSessionWarnThreshold = 3                   // warn when ≥ this many stale sessions\n808: \tstaleEndedSessionWarnInterval  = 24 * time.Hour      // rate-limit window\n809: \tstaleEndedSessionWarnFile      = \".warn-stale-ended\" // sentinel file name in entire-sessions/\n810: )\n811: \n812: // stderrWriter is the destination for user-facing warnings emitted outside of\n813: // Cobra command output (e.g. from PostCommit). Tests can swap this to capture\n814: // output without mutating the process-global os.Stderr.\n815: var stderrWriter io.Writer = os.Stderr\n816: \n817: // warnStaleEndedSessions emits a rate-limited warning to stderr when too many\n818: // non-FullyCondensed ENDED sessions are accumulating.\n819: func warnStaleEndedSessions(ctx context.Context, count int) {\n820: \twarnStaleEndedSessionsTo(ctx, count, stderrWriter)\n821: }\n822: \n823: func warnStaleEndedSessionsTo(ctx context.Context, count int, w io.Writer) {\n824: \tcommonDir, err := GetGitCommonDir(ctx)\n825: \tif err != nil {\n826: \t\treturn // fail-open\n827: \t}\n828: \twarnDir := filepath.Join(commonDir, session.SessionStateDirName)\n829: \twarnFile := filepath.Join(warnDir, staleEndedSessionWarnFile)\n830: \tif info, statErr := os.Stat(warnFile); statErr == nil {\n831: \t\tif time.Since(info.ModTime()) < staleEndedSessionWarnInterval {\n832: \t\t\treturn // rate-limited\n833: \t\t}\n834: \t}\n835: \t//nolint:errcheck,gosec // G104: Best-effort warning — fail-open if file ops fail\n836: \tos.MkdirAll(warnDir, 0o750)\n837: \t//nolint:errcheck,gosec // G104: Best-effort sentinel file write\n838: \tos.WriteFile(warnFile, []byte{}, 0o644)\n839: \tfmt.Fprintf(w,\n840: \t\t\"\\nentire: %d ended session(s) are accumulating and slowing down commits.\\n\"+\n841: \t\t\t\"Run 'entire doctor' to condense them and restore commit performance.\\n\\n\",\n842: \t\tcount,\n843: \t)\n844: }\n845: \n846: // activeSessionInteractionThreshold is the maximum age of LastInteractionTime\n847: // for an ACTIVE session to be considered genuinely active. 24h is generous\n848: // because LastInteractionTime only updates at TurnStart, not per-tool-call.\n849: const activeSessionInteractionThreshold = 24 * time.Hour\n850: \n851: // isRecentInteraction returns true if lastInteraction is non-nil and within\n852: // activeSessionInteractionThreshold of now.\n853: func isRecentInteraction(lastInteraction *time.Time) bool {\n854: \treturn lastInteraction != nil && time.Since(*lastInteraction) < activeSessionInteractionThreshold\n855: }\n856: \n857: func (h *postCommitActionHandler) HandleDiscardIfNoFiles(state *session.State) error {\n858: \tif len(state.FilesTouched) == 0 {\n859: \t\tlogging.Debug(logging.WithComponent(h.ctx, \"checkpoint\"), \"post-commit: skipping empty ended session (no files to condense)\",\n860: \t\t\tslog.String(\"session_id\", state.SessionID),\n861: \t\t)\n862: \t}\n863: \th.s.updateBaseCommitIfChanged(h.ctx, state, h.newHead)\n864: \treturn nil\n865: }\n866: \n867: func (h *postCommitActionHandler) HandleWarnStaleSession(_ *session.State) error {\n868: \t// Not produced by EventGitCommit; no-op for exhaustiveness.\n869: \treturn nil\n870: }\n871: \n872: // During rebase/cherry-pick/revert operations, phase transitions are skipped entirely.\n873: //\n874: \n875: func (s *ManualCommitStrategy) PostCommit(ctx context.Context) error { //nolint:unparam // error return is part of the hook contract; callers check it\n876: \tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n877: \n878: \t_, openRepoSpan := perf.Start(ctx, \"open_repository_and_head\")\n879: \trepo, err := OpenRepository(ctx)\n880: \tif err != nil {\n881: \t\topenRepoSpan.RecordError(err)\n882: \t\topenRepoSpan.End()\n883: \t\treturn nil\n884: \t}\n885: \n886: \t// Get HEAD commit to check for trailer\n887: \thead, err := repo.Head()\n888: \tif err != nil {\n889: \t\topenRepoSpan.RecordError(err)\n890: \t\topenRepoSpan.End()\n891: \t\treturn nil\n892: \t}\n893: \n894: \tcommit, err := repo.CommitObject(head.Hash())\n895: \tif err != nil {\n896: \t\topenRepoSpan.RecordError(err)\n897: \t\topenRepoSpan.End()\n898: \t\treturn nil\n899: \t}\n900: \n901: \t// Check if commit has checkpoint trailer (ParseCheckpoint validates format)\n902: \tcheckpointID, found := trailers.ParseCheckpoint(commit.Message)\n903: \topenRepoSpan.End()\n904: \n905: \tif !found {\n906: \t\t// No trailer — user removed it or it was never added (mid-turn commit).\n907: \t\t// Still update BaseCommit for active sessions so future commits can match.\n908: \t\ts.postCommitUpdateBaseCommitOnly(ctx, head)\n909: \t\treturn nil\n910: \t}\n911: \n912: \t_, findSessionsSpan := perf.Start(ctx, \"find_sessions_for_worktree\")\n913: \tworktreePath, err := paths.WorktreeRoot(ctx)\n914: \tif err != nil {\n915: \t\tfindSessionsSpan.RecordError(err)\n916: \t\tfindSessionsSpan.End()\n917: \t\treturn nil\n918: \t}\n919: \n920: \t// Find all active sessions for this worktree\n921: \tsessions, err := s.findSessionsForWorktree(ctx, worktreePath)\n922: \tfindSessionsSpan.RecordError(err)\n923: \tfindSessionsSpan.End()\n924: \n925: \tif err != nil || len(sessions) == 0 {\n926: \t\tlogging.Warn(logCtx, \"post-commit: no active sessions despite trailer\",\n927: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n928: \t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n929: \t\t)\n930: \t\treturn nil //nolint:nilerr // Intentional: hooks must be silent on failure\n931: \t}\n932: \n933: \t// Build transition context\n934: \tisRebase := isGitSequenceOperation(ctx)\n935: \ttransitionCtx := session.TransitionContext{\n936: \t\tIsRebaseInProgress: isRebase,\n937: \t}\n938: \n939: \tif isRebase {\n940: \t\tlogging.Debug(logCtx, \"post-commit: rebase/sequence in progress, skipping phase transitions\",\n941: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n942: \t\t)\n943: \t}\n944: \n945: \t// Track shadow branch names and whether they can be deleted\n946: \tshadowBranchesToDelete := make(map[string]struct{})\n947: \t// Track active sessions that were NOT condensed — their shadow branches must be preserved\n948: \tuncondensedActiveOnBranch := make(map[string]bool)\n949: \n950: \tnewHead := head.Hash().String()\n951: \n952: \t// Pre-resolve HEAD tree and parent tree once for the entire PostCommit.\n953: \t// These are immutable within this hook invocation and used by multiple\n954: \t// per-session functions (filesOverlapWithContent, filesWithRemainingAgentChanges,\n955: \t// calculateSessionAttributions).\n956: \t_, resolveTreesSpan := perf.Start(ctx, \"resolve_commit_trees\")\n957: \tvar headTree *object.Tree\n958: \tif t, err := commit.Tree(); err == nil {\n959: \t\theadTree = t\n960: \t}\n961: \tvar parentTree *object.Tree\n962: \tif commit.NumParents() > 0 {\n963: \t\tif parent, err := commit.Parent(0); err == nil {\n964: \t\t\tif t, err := parent.Tree(); err == nil {\n965: \t\t\t\tparentTree = t\n966: \t\t\t}\n967: \t\t}\n968: \t}\n969: \n970: \tcommittedFileSet := filesChangedInCommit(ctx, worktreePath, commit, headTree, parentTree)\n971: \tresolveTreesSpan.End()\n972: \n973: \t// Compute union of all sessions' FilesTouched for cross-session attribution,\n974: \t// and count sessions whose tracked files overlap with committed files.\n975: \tallAgentFiles := make(map[string]struct{})\n976: \tsessionsWithCommittedFiles := 0\n977: \tfor _, state := range sessions {\n978: \t\tif state.FullyCondensed && state.Phase == session.PhaseEnded {\n979: \t\t\tcontinue\n980: \t\t}\n981: \t\tfor _, f := range state.FilesTouched {\n982: \t\t\tallAgentFiles[f] = struct{}{}\n983: \t\t\tif _, ok := committedFileSet[f]; ok {\n984: \t\t\t\tsessionsWithCommittedFiles++\n985: \t\t\t\tbreak // count each session at most once\n986: \t\t\t}\n987: \t\t}\n988: \t}\n989: \n990: \tloopCtx, processSessionsLoop := perf.StartLoop(ctx, \"process_sessions\")\n991: \tfor _, sess := range sessions {\n992: \t\tif sess.FullyCondensed && sess.Phase == session.PhaseEnded {\n993: \t\t\tcontinue\n994: \t\t}\n995: \t\tsessionID := sess.SessionID\n996: \t\titerCtx, iterSpan := processSessionsLoop.Iteration(loopCtx)\n997: \t\tmutErr := MutateSessionState(iterCtx, sessionID, func(state *SessionState) error {\n998: \t\t\ts.postCommitProcessSessionLocked(iterCtx, repo, state, &transitionCtx, checkpointID,\n999: \t\t\t\thead, commit, newHead, worktreePath, headTree, parentTree,\n1000: \t\t\t\tcommittedFileSet, shadowBranchesToDelete, uncondensedActiveOnBranch, allAgentFiles,\n1001: \t\t\t\tsessionsWithCommittedFiles)\n1002: \t\t\treturn nil\n1003: \t\t})\n1004: \t\tif mutErr != nil && !errors.Is(mutErr, ErrStateNotFound) {\n1005: \t\t\tlogging.Warn(logCtx, \"post-commit: session mutation failed\",\n1006: \t\t\t\tslog.String(\"session_id\", sessionID),\n1007: \t\t\t\tslog.String(\"error\", mutErr.Error()))\n1008: \t\t}\n1009: \t\titerSpan.End()\n1010: \t}\n1011: \tprocessSessionsLoop.End()\n1012: \n1013: \tif err := s.updateCombinedAttributionForCheckpoint(ctx, repo, checkpointID, headTree, parentTree, worktreePath); err != nil {\n1014: \t\tlogging.Warn(logCtx, \"failed to update combined checkpoint attribution\",\n1015: \t\t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n1016: \t\t\tslog.String(\"error\", err.Error()))\n1017: \t}\n1018: \n1019: \t// Clean up shadow branches — only delete when ALL sessions on the branch are non-active\n1020: \t// or were condensed during this PostCommit.\n1021: \t_, cleanupBranchesSpan := perf.Start(ctx, \"cleanup_shadow_branches\")\n1022: \tfor shadowBranchName := range shadowBranchesToDelete {\n1023: \t\tif uncondensedActiveOnBranch[shadowBranchName] {\n1024: \t\t\tlogging.Debug(logCtx, \"post-commit: preserving shadow branch (active session exists)\",\n1025: \t\t\t\tslog.String(\"shadow_branch\", shadowBranchName),\n1026: \t\t\t)\n1027: \t\t\tcontinue\n1028: \t\t}\n1029: \t\tif err := deleteShadowBranch(ctx, repo, shadowBranchName); err != nil {\n1030: \t\t\tlogging.Warn(logCtx, \"failed to clean up shadow branch\",\n1031: \t\t\t\tslog.String(\"shadow_branch\", shadowBranchName),\n1032: \t\t\t\tslog.String(\"error\", err.Error()))\n1033: \t\t} else {\n1034: \t\t\tlogging.Info(logCtx, \"shadow branch deleted\",\n1035: \t\t\t\tslog.String(\"strategy\", \"manual-commit\"),\n1036: \t\t\t\tslog.String(\"shadow_branch\", shadowBranchName),\n1037: \t\t\t)\n1038: \t\t}\n1039: \t}\n1040: \tcleanupBranchesSpan.End()\n1041: \n1042: \tif stale := countWarnableStaleEndedSessions(repo, sessions); stale >= staleEndedSessionWarnThreshold {\n1043: \t\twarnStaleEndedSessions(ctx, stale)\n1044: \t}\n1045: \n1046: \treturn nil\n1047: }\n1048: \n1049: // updateCombinedAttributionForCheckpoint computes holistic attribution across all sessions.\n1050: // Instead of summing per-session numbers (which inflates totals because each session\n1051: // independently counts the full commit), this diffs parent→HEAD once and classifies\n1052: // lines as agent or human based on the union of all sessions' files_touched.\n1053: func (s *ManualCommitStrategy) updateCombinedAttributionForCheckpoint(\n1054: \tctx context.Context,\n1055: \trepo *git.Repository,\n1056: \tcheckpointID id.CheckpointID,\n1057: \theadTree, parentTree *object.Tree,\n1058: \trepoDir string,\n1059: ) error {\n1060: \tlogCtx := logging.WithComponent(ctx, \"attribution\")\n1061: \tstore := checkpoint.NewGitStore(repo)\n1062: \n1063: \tsummary, err := store.ReadCommitted(ctx, checkpointID)\n1064: \tif err != nil {\n1065: \t\treturn fmt.Errorf(\"reading checkpoint summary: %w\", err)\n1066: \t}\n1067: \tif summary == nil || len(summary.Sessions) <= 1 {\n1068: \t\treturn nil\n1069: \t}\n1070: \n1071: \t// Collect union of files_touched from sessions that had real checkpoints (SaveStep ran).\n1072: \t// Sessions with checkpoints_count == 0 (e.g., commit-only sessions) use a fallback that\n1073: \t// includes ALL committed files, which would incorrectly classify human-created files as agent work.\n1074: \tagentFiles := make(map[string]struct{})\n1075: \tfor i := range len(summary.Sessions) {\n1076: \t\tmetadata, readErr := store.ReadSessionMetadata(ctx, checkpointID, i)\n1077: \t\tif readErr != nil || metadata == nil {\n1078: \t\t\tcontinue\n1079: \t\t}\n1080: \t\tif metadata.CheckpointsCount == 0 {\n1081: \t\t\tcontinue // Skip sessions that used the filesTouched fallback\n1082: \t\t}\n1083: \t\tfor _, f := range metadata.FilesTouched {\n1084: \t\t\tagentFiles[f] = struct{}{}\n1085: \t\t}\n1086: \t}\n1087: \n1088: \tif len(agentFiles) == 0 {\n1089: \t\treturn nil\n1090: \t}\n1091: \n1092: \t// Get all files changed in this commit (parent → HEAD)\n1093: \tallChangedFiles, err := getAllChangedFiles(ctx, parentTree, headTree, repoDir, \"\", \"\")\n1094: \tif err != nil {\n1095: \t\tlogging.Warn(logCtx, \"combined attribution: failed to enumerate changed files\",\n1096: \t\t\tslog.String(\"error\", err.Error()))\n1097: \t\treturn nil\n1098: \t}\n1099: \n1100: \t// Classify each changed file as agent or human and count lines\n1101: \tvar agentAdded, agentRemoved, humanAdded, humanRemoved int\n1102: \tfor _, filePath := range allChangedFiles {\n1103: \t\t// Skip CLI/agent config metadata — not human or agent code work\n1104: \t\tif strings.HasPrefix(filePath, \".entire/\") || strings.HasPrefix(filePath, paths.EntireMetadataDir+\"/\") ||\n1105: \t\t\tstrings.HasPrefix(filePath, \".claude/\") {\n1106: \t\t\tcontinue\n1107: \t\t}\n1108: \n1109: \t\tparentContent := getFileContent(parentTree, filePath)\n1110: \t\theadContent := getFileContent(headTree, filePath)\n1111: \t\t_, added, removed := diffLines(parentContent, headContent)\n1112: \n1113: \t\tif _, isAgent := agentFiles[filePath]; isAgent {\n1114: \t\t\tagentAdded += added\n1115: \t\t\tagentRemoved += removed\n1116: \t\t} else {\n1117: \t\t\thumanAdded += added\n1118: \t\t\thumanRemoved += removed\n1119: \t\t}\n1120: \t}\n1121: \n1122: \ttotalLinesChanged := agentAdded + agentRemoved + humanAdded + humanRemoved\n1123: \ttotalCommitted := agentAdded + humanAdded\n1124: \n1125: \tvar agentPercentage float64\n1126: \tif totalLinesChanged > 0 {\n1127: \t\tagentPercentage = float64(agentAdded+agentRemoved) / float64(totalLinesChanged) * 100\n1128: \t}\n1129: \n1130: \tcombined := &checkpoint.InitialAttribution{\n1131: \t\tCalculatedAt:      time.Now().UTC(),\n1132: \t\tAgentLines:        agentAdded,\n1133: \t\tAgentRemoved:      agentRemoved,\n1134: \t\tHumanAdded:        humanAdded,\n1135: \t\tHumanRemoved:      humanRemoved,\n1136: \t\tTotalCommitted:    totalCommitted,\n1137: \t\tTotalLinesChanged: totalLinesChanged,\n1138: \t\tAgentPercentage:   agentPercentage,\n1139: \t\tMetricVersion:     2,\n1140: \t}\n1141: \n1142: \tlogging.Info(logCtx, \"combined attribution calculated\",\n1143: \t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n1144: \t\tslog.Int(\"sessions\", len(summary.Sessions)),\n1145: \t\tslog.Int(\"agent_files\", len(agentFiles)),\n1146: \t\tslog.Int(\"agent_lines\", agentAdded),\n1147: \t\tslog.Int(\"human_added\", humanAdded),\n1148: \t\tslog.Float64(\"agent_percentage\", agentPercentage),\n1149: \t)\n1150: \n1151: \tif err := store.UpdateCheckpointSummary(ctx, checkpointID, combined); err != nil {\n1152: \t\treturn fmt.Errorf(\"persisting combined attribution: %w\", err)\n1153: \t}\n1154: \n1155: \treturn nil\n1156: }\n1157: \n1158: // postCommitProcessSessionLocked handles a single session within the PostCommit loop.\n1159: // Pre-resolved git objects (headTree, parentTree) are shared across all sessions;\n1160: // per-session shadow ref/tree are resolved once here and threaded through sub-calls.\n1161: //\n1162: // MUST be called from inside MutateSessionState. Mutations to state are persisted\n1163: // by the caller's outer save — calling this function standalone silently loses\n1164: // every field change (StepCount, FilesTouched, CheckpointTranscriptStart, …).\n1165: func (s *ManualCommitStrategy) postCommitProcessSessionLocked(\n1166: \tctx context.Context,\n1167: \trepo *git.Repository,\n1168: \tstate *SessionState,\n1169: \ttransitionCtx *session.TransitionContext,\n1170: \tcheckpointID id.CheckpointID,\n1171: \thead *plumbing.Reference,\n1172: \tcommit *object.Commit,\n1173: \tnewHead string,\n1174: \trepoDir string,\n1175: \theadTree, parentTree *object.Tree,\n1176: \tcommittedFileSet map[string]struct{},\n1177: \tshadowBranchesToDelete map[string]struct{},\n1178: \tuncondensedActiveOnBranch map[string]bool,\n1179: \tallAgentFiles map[string]struct{},\n1180: \tsessionsWithCommittedFiles int,\n1181: ) {\n1182: \tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n1183: \tshadowBranchName := getShadowBranchNameForCommit(state.BaseCommit, state.WorktreeID)\n1184: \n1185: \t// Pre-resolve shadow branch ref and tree for this session.\n1186: \t// These are read 4+ times across sessionHasNewContent, filesOverlapWithContent,\n1187: \t// CondenseSession, filesWithRemainingAgentChanges, and calculateSessionAttributions.\n1188: \t_, resolveShadowBranchSpan := perf.Start(ctx, \"resolve_shadow_branch\")\n1189: \tvar shadowRef *plumbing.Reference\n1190: \tvar shadowTree *object.Tree\n1191: \tif ref, refErr := repo.Reference(plumbing.NewBranchReferenceName(shadowBranchName), true); refErr == nil {\n1192: \t\tshadowRef = ref\n1193: \t\tif sc, scErr := repo.CommitObject(ref.Hash()); scErr == nil {\n1194: \t\t\tif st, stErr := sc.Tree(); stErr == nil {\n1195: \t\t\t\tshadowTree = st\n1196: \t\t\t}\n1197: \t\t}\n1198: \t}\n1199: \tresolveShadowBranchSpan.End()\n1200: \n1201: \t// Check for new content (needed for TransitionContext and condensation).\n1202: \t// Fail-open: if content check errors, assume new content exists so we\n1203: \t// don't silently skip data that should have been condensed.\n1204: \t//\n1205: \t// For ACTIVE sessions: the commit has a checkpoint trailer (verified above),\n1206: \t// meaning PrepareCommitMsg already determined this commit is session-related.\n1207: \t// The trailer is only added when either:\n1208: \t//   - No TTY (agent/subagent committing) — added unconditionally\n1209: \t//   - TTY (human committing) — added after content detection confirmed agent work\n1210: \t// In both cases, PrepareCommitMsg already validated this commit. We trust\n1211: \t// that decision here. Transcript-based re-validation is unreliable because\n1212: \t// subagent transcripts may not be available yet (subagent still running).\n1213: \t_, checkContentSpan := perf.Start(ctx, \"check_session_content\")\n1214: \tvar hasNew bool\n1215: \tif state.Phase.IsActive() {\n1216: \t\thasNew = true\n1217: \t} else {\n1218: \t\tvar contentErr error\n1219: \t\thasNew, contentErr = s.sessionHasNewContent(ctx, repo, state, contentCheckOpts{shadowTree: shadowTree})\n1220: \t\tif contentErr != nil {\n1221: \t\t\thasNew = true\n1222: \t\t\tlogging.Debug(logCtx, \"post-commit: error checking session content, assuming new content\",\n1223: \t\t\t\tslog.String(\"session_id\", state.SessionID),\n1224: \t\t\t\tslog.String(\"error\", contentErr.Error()),\n1225: \t\t\t)\n1226: \t\t}\n1227: \t}\n1228: \ttransitionCtx.HasFilesTouched = len(state.FilesTouched) > 0\n1229: \n1230: \t// Save FilesTouched BEFORE TransitionAndLog — the handler's condensation\n1231: \t// clears it, but we need the original list for carry-forward computation.\n1232: \t// Only fall back to transcript extraction for ACTIVE sessions — IDLE/ENDED\n1233: \t// sessions have FilesTouched already populated by SaveStep/mergeFilesTouched.\n1234: \tvar filesTouchedBefore []string\n1235: \tif state.Phase.IsActive() {\n1236: \t\tfilesTouchedBefore = s.resolveFilesTouched(ctx, state)\n1237: \t} else if len(state.FilesTouched) > 0 {\n1238: \t\tfilesTouchedBefore = make([]string, len(state.FilesTouched))\n1239: \t\tcopy(filesTouchedBefore, state.FilesTouched)\n1240: \t}\n1241: \tcheckContentSpan.End()\n1242: \n1243: \tlogging.Debug(logCtx, \"post-commit: carry-forward prep\",\n1244: \t\tslog.String(\"session_id\", state.SessionID),\n1245: \t\tslog.Bool(\"is_active\", state.Phase.IsActive()),\n1246: \t\tslog.String(\"transcript_path\", state.TranscriptPath),\n1247: \t\tslog.Int(\"files_touched_before\", len(filesTouchedBefore)),\n1248: \t\tslog.Any(\"files\", filesTouchedBefore),\n1249: \t)\n1250: \n1251: \t// Run the state machine transition with handler for strategy-specific actions.\n1252: \t_, transitionAndCondenseSpan := perf.Sta