//\n85: // The interface is organized into two groups:\n86: //   - Hook Mapping (2 methods): HookNames, ParseHookEvent\n87: //   - Hook Management (3 methods): InstallHooks, UninstallHooks, AreHooksInstalled\n88: type HookSupport interface {\n89: \tAgent\n90: \n91: \t// HookNames returns the hook verbs this agent supports.\n92: \t// These become subcommands under `entire hooks <agent>`.\n93: \t// e.g., [\"stop\", \"user-prompt-submit\", \"session-start\", \"session-end\"]\n94: \tHookNames() []string\n95: \n96: \t// ParseHookEvent translates an agent-native hook into a normalized lifecycle Event.\n97: \t// Returns nil if the hook has no lifecycle significance (e.g., pass-through hooks).\n98: \t// This is the core contribution surface for new agent implementations.\n99: \tParseHookEvent(ctx context.Context, hookName string, stdin io.Reader) (*Event, error)\n100: \n101: \t// InstallHooks installs agent-specific hooks.\n102: \t// If localDev is true, hooks point to local development build.\n103: \t// If force is true, removes existing Entire hooks before installing.\n104: \t// Returns the number of hooks installed.\n105: \tInstallHooks(ctx context.Context, localDev bool, force bool) (int, error)\n106: \n107: \t// UninstallHooks removes installed hooks\n108: \tUninstallHooks(ctx context.Context) error\n109: \n110: \t// AreHooksInstalled checks if hooks are currently installed\n111: \tAreHooksInstalled(ctx context.Context) bool\n112: }\n113: \n114: // FileWatcher is implemented by agents that use file-based detection.\n115: // Agents like Aider that don't support hooks can use file watching\n116: // to detect session activity.\n117: type FileWatcher interface {\n118: \tAgent\n119: \n120: \t// GetWatchPaths returns paths to watch for session changes\n121: \tGetWatchPaths() ([]string, error)\n122: \n123: \t// OnFileChange handles a detected file change and returns session info\n124: \tOnFileChange(path string) (*SessionChange, error)\n125: }\n126: \n127: // ProtectedFilesProvider is implemented by agents that need to exclude\n128: // repo-root-relative files owned by the agent integration itself from session\n129: // tracking or destructive operations.\n130: type ProtectedFilesProvider interface {\n131: \tAgent\n132: \n133: \t// ProtectedFiles returns repo-root-relative files that belong to the\n134: \t// agent's own config/state and should be excluded from tracking.\n135: \tProtectedFiles() []string\n136: }\n137: \n138: // TranscriptAnalyzer provides format-specific transcript parsing.\n139: // Agents that implement this get richer checkpoints (transcript-derived file lists,\n140: // prompts, summaries). Agents that don't still participate in the checkpoint lifecycle\n141: // via git-status-based file detection and raw transcript storage.\n142: type TranscriptAnalyzer interface {\n143: \tAgent\n144: \n145: \t// GetTranscriptPosition returns the current position (length) of a transcript.\n146: \t// For JSONL formats (Claude Code), this is the line count.\n147: \t// For JSON formats (Gemini CLI), this is the message count.\n148: \t// Returns 0 if the file doesn't exist or is empty.\n149: \tGetTranscriptPosition(path string) (int, error)\n150: \n151: \t// ExtractModifiedFilesFromOffset extracts files modified since a given offset.\n152: \t// For JSONL formats (Claude Code), offset is the starting line number.\n153: \t// For JSON formats (Gemini CLI), offset is the starting message index.\n154: \t// Returns:\n155: \t//   - files: list of file paths modified by the agent (from Write/Edit tools)\n156: \t//   - currentPosition: the current position (line count or message count)\n157: \t//   - error: any error encountered during reading\n158: \tExtractModifiedFilesFromOffset(path string, startOffset int) (files []string, currentPosition int, err error)\n159: }\n160: \n161: // PromptExtractor extracts user prompts from a transcript file.\n162: // Used as a fallback when prompt data isn't captured via hooks (e.g., Factory AI\n163: // Droid's exec mode doesn't fire UserPromptSubmit).\n164: type PromptExtractor interface {\n165: \tAgent\n166: \n167: \t// ExtractPrompts returns user prompts from the transcript starting at the given offset.\n168: \tExtractPrompts(sessionRef string, fromOffset int) ([]string, error)\n169: }\n170: \n171: // TranscriptPreparer is called before ReadTranscript to handle agent-specific\n172: // flush/sync requirements (e.g., Claude Code's async transcript writing).\n173: // The framework calls PrepareTranscript before ReadTranscript if implemented.\n174: type TranscriptPreparer interface {\n175: \tAgent\n176: \n177: \t// PrepareTranscript ensures the transcript is ready to read.\n178: \t// For Claude Code, this waits for the async transcript flush to complete.\n179: \tPrepareTranscript(ctx context.Context, sessionRef string) error\n180: }\n181: \n182: // TokenCalculator provides token usage calculation for a session.\n183: // The framework calls this during step save and checkpoint if implemented.\n184: type TokenCalculator interface {\n185: \tAgent\n186: \n187: \t// CalculateTokenUsage computes token usage from the transcript starting at the given offset.\n188: \tCalculateTokenUsage(transcriptData []byte, fromOffset int) (*TokenUsage, error)\n189: }\n190: \n191: // TextGenerator is an optional interface for agents whose CLI supports\n192: // non-interactive text generation (e.g., claude --print).\n193: // Used for AI-powered metadata generation (trail titles, summaries).\n194: type TextGenerator interface {\n195: \tAgent\n196: \n197: \t// GenerateText sends a prompt to the agent's CLI and returns the raw text response.\n198: \t// model is a hint (e.g., \"haiku\", \"sonnet\"). Implementations may ignore if not applicable.\n199: \tGenerateText(ctx context.Context, prompt string, model string) (string, error)\n200: }\n201: \n202: // CompactedTranscript contains the result of transcript compaction into Entire\n203: // Transcript Format. Assets are accepted in the protocol shape for forward\n204: // compatibility but may not yet be persisted by all call sites.\n205: type CompactedTranscript struct {\n206: \tTranscript []byte\n207: \tAssets     []CompactedTranscriptAsset\n208: }\n209: \n210: // CompactedTranscriptAsset is binary data extracted during transcript compaction.\n211: type CompactedTranscriptAsset struct {\n212: \tName      string\n213: \tMediaType string\n214: \tData      []byte\n215: }\n216: \n217: // TranscriptCompactor is implemented by agents that can produce Entire\n218: // Transcript Format directly from their native transcript representation.\n219: type TranscriptCompactor interface {\n220: \tAgent\n221: \n222: \t// CompactTranscript converts the transcript referenced by sessionRef into\n223: \t// Entire Transcript Format and returns the compact transcript bytes.\n224: \tCompactTranscript(ctx context.Context, sessionRef string) (*CompactedTranscript, error)\n225: }\n226: \n227: // HookResponseWriter is implemented by agents that support structured hook responses.\n228: // Agents that implement this can output messages (e.g., banners) to the user via\n229: // the agent's response protocol. For example, Claude Code outputs JSON with a\n230: // systemMessage field to stdout. Agents that don't implement this will silently\n231: // skip hook response output.\n232: type HookResponseWriter interface {\n233: \tAgent\n234: \n235: \t// WriteHookResponse outputs a message to the user via the agent's hook response protocol.\n236: \tWriteHookResponse(message string) error\n237: }\n238: \n239: // RestoredSessionPathResolver is implemented by agents that need a\n240: // transcript-specific path when Entire reconstructs a session from checkpoint\n241: // metadata. This is used for restored sessions only; live sessions still use\n242: // the agent's native hook/session references.\n243: type RestoredSessionPathResolver interface {\n244: \tAgent\n245: \n246: \t// ResolveRestoredSessionFile returns where Entire should write a restored\n247: \t// transcript so the agent can discover it later.\n248: \tResolveRestoredSessionFile(sessionDir, agentSessionID string, transcript []byte) (string, error)\n249: }\n250: \n251: // TestOnly is implemented by agents that exist solely for testing (e.g., the Vogon canary agent).\n252: // These agents are excluded from the user-facing agent selection in `entire enable`.\n253: type TestOnly interface {\n254: \tAgent\n255: \tIsTestOnly() bool\n256: }\n257: \n258: // Launcher is implemented by agents that `entire` can subprocess-spawn.\n259: // This is used by `entire review` to start an agent with a pre-composed\n260: // initial prompt; other commands may use it later.\n261: //\n262: // Contract:\n263: //   - LaunchCmd builds an *exec.Cmd with stdin/stdout/stderr wired to the\n264: //     caller's TTY. The agent runs in the foreground and the call blocks.\n265: //   - The returned cmd is ready to Run() or Start(); it must NOT be modified\n266: //     by the caller except to set environment variables or working dir.\n267: //   - initialPrompt is the first user message to send to the agent.\n268: type Launcher interface {\n269: \tLaunchCmd(ctx context.Context, initialPrompt string) (*exec.Cmd, error)\n270: }\n271: \n272: // DiscoveredSkill describes one review-adjacent skill found on disk by a\n273: // SkillDiscoverer. Name is the agent-native invocation form (e.g. a\n274: // slash-prefixed command); Description is scraped from on-disk metadata\n275: // if available; SourcePath is kept for debug logging and is not shown to\n276: // the user.\n277: type DiscoveredSkill struct {\n278: \tName        string\n279: \tDescription string\n280: \tSourcePath  string\n281: }\n282: \n283: // SkillDiscoverer is implemented by agents that can enumerate review-adjacent\n284: // skills installed locally on disk (e.g. plugin skills under\n285: // ~/.claude/plugins/...). This powers the \"Installed plugin skills\" section\n286: // of the `entire review` picker and the runtime verification that configured\n287: // skills still exist before spawn.\n288: //\n289: // Contract:\n290: //   - Safe to call on fresh installs where no plugin dir exists yet —\n291: //     return (nil, nil), not an error.\n292: //   - Malformed individual skill metadata must be skipped with a Debug log,\n293: //     not propagated as an error.\n294: //   - A (nil, non-nil) error means \"discovery could not run at all\" (e.g.\n295: //     home dir inaccessible). Callers may treat all errors as \"found nothing\"\n296: //     and log at Debug — discovery must never block the picker.\n297: type SkillDiscoverer interface {\n298: \tAgent\n299: \tDiscoverReviewSkills(ctx context.Context) ([]DiscoveredSkill, error)\n300: }\n301: \n302: // SessionBaseDirProvider is implemented by agents that store transcripts in a\n303: // home-directory-based structure with per-project subdirectories. This enables\n304: // cross-project transcript search (e.g., when a session was started from a\n305: // different working directory). Agents with ephemeral/temp-based storage or\n306: // flat session layouts should NOT implement this interface.\n307: type SessionBaseDirProvider interface {\n308: \tAgent\n309: \n310: \t// GetSessionBaseDir returns the base directory containing per-project\n311: \t// session subdirectories (e.g., ~/.claude/projects, ~/.gemini/tmp).\n312: \tGetSessionBaseDir() (string, error)\n313: }\n314: \n315: // SubagentAwareExtractor provides methods for extracting files and tokens including subagents.\n316: // Agents that support spawning subagents (like Claude Code's Task tool) should implement this\n317: // to ensure subagent contributions are included in checkpoints.\n318: type SubagentAwareExtractor interface {\n319: \tAgent\n320: \n321: \t// ExtractAllModifiedFiles extracts files modified by both the main agent and any spawned subagents.\n322: \t// The subagentsDir parameter specifies where subagent transcripts are stored.\n323: \t// Returns a deduplicated list of all modified file paths.