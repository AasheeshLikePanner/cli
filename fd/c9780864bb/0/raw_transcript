              "patch": "Index: cmd/entire/cli/prompts/index/rank_test.go\n===================================================================\n--- cmd/entire/cli/prompts/index/rank_test.go\t\n+++ cmd/entire/cli/prompts/index/rank_test.go\t\n@@ -0,0 +1,136 @@\n+package index\n+\n+import (\n+\t\"testing\"\n+\t\"time\"\n+)\n+\n+func TestTokenize(t *testing.T) {\n+\tt.Parallel()\n+\n+\ttests := []struct {\n+\t\tinput    string\n+\t\texpected []string\n+\t}{\n+\t\t{\"hello world\", []string{\"hello\", \"world\"}},\n+\t\t{\"The quick brown fox\", []string{\"quick\", \"brown\", \"fox\"}},\n+\t\t{\"authentication\", []string{\"authent\"}},\n+\t\t{\"caching\", []string{\"cach\"}},\n+\t\t{\"\", []string{}},\n+\t\t{\"a\", []string{}},\n+\t\t{\"ab\", []string{\"ab\"}},\n+\t}\n+\n+\tfor _, tt := range tests {\n+\t\tresult := Tokenize(tt.input)\n+\t\tif len(result) != len(tt.expected) {\n+\t\t\tt.Errorf(\"Tokenize(%q) = %v, want %v\", tt.input, result, tt.expected)\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor i := range result {\n+\t\t\tif result[i] != tt.expected[i] {\n+\t\t\t\tt.Errorf(\"Tokenize(%q)[%d] = %v, want %v\", tt.input, i, result[i], tt.expected[i])\n+\t\t\t}\n+\t\t}\n+\t}\n+}\n+\n+func TestParseQuery(t *testing.T) {\n+\tt.Parallel()\n+\n+\ttests := []struct {\n+\t\tinput      string\n+\t\twantPhrase string\n+\t\twantTokens int\n+\t}{\n+\t\t{\"cache decision\", \"\", 2},\n+\t\t{`\"cache decision\"`, \"cache decision\", 2},\n+\t\t{\"hello\", \"\", 1},\n+\t\t{\"the hello\", \"\", 1}, // stop word filtered\n+\t\t{\"\", \"\", 0},\n+\t}\n+\n+\tfor _, tt := range tests {\n+\t\tq := ParseQuery(tt.input)\n+\t\tif tt.wantPhrase != \"\" && q.Phrase != tt.wantPhrase {\n+\t\t\tt.Errorf(\"ParseQuery(%q).Phrase = %q, want %q\", tt.input, q.Phrase, tt.wantPhrase)\n+\t\t}\n+\t\tif len(q.Tokens) != tt.wantTokens {\n+\t\t\tt.Errorf(\"ParseQuery(%q) tokens = %d, want %d\", tt.input, len(q.Tokens), tt.wantTokens)\n+\t\t}\n+\t}\n+}\n+\n+func TestScoreEntry(t *testing.T) {\n+\tt.Parallel()\n+\n+\tentry := PromptEntry{\n+\t\tPromptText: \"I need to add caching to improve performance\",\n+\t}\n+\n+\tquery := ParseQuery(\"cache performance\")\n+\n+\tresult := ScoreEntry(entry, query)\n+\tif result.Score <= 0 {\n+\t\tt.Errorf(\"ScoreEntry() = %v, want > 0\", result.Score)\n+\t}\n+}\n+\n+func TestSearchWithFilters(t *testing.T) {\n+\tt.Parallel()\n+\n+\tentries := []PromptEntry{\n+\t\t{CheckpointID: \"abc123\", Agent: \"claude-code\", Branch: \"main\", Kind: \"session\", PromptText: \"add caching\", CreatedAt: time.Now().Add(-1)},\n+\t\t{CheckpointID: \"def456\", Agent: \"gemini\", Branch: \"main\", Kind: \"session\", PromptText: \"fix bug\", CreatedAt: time.Now()},\n+\t\t{CheckpointID: \"ghi789\", Agent: \"claude-code\", Branch: \"feature\", Kind: \"agent_review\", PromptText: \"review code\", CreatedAt: time.Now().Add(-2)},\n+\t}\n+\n+\tcfg := SearchConfig{Query: \"cach\", Agent: \"claude-code\"}\n+\tresults := Search(entries, cfg)\n+\n+\tif len(results) != 1 {\n+\t\tt.Errorf(\"Search() returned %d results, want 1\", len(results))\n+\t}\n+\tif results[0].Entry.CheckpointID != \"abc123\" {\n+\t\tt.Errorf(\"Search() returned %q, want abc123\", results[0].Entry.CheckpointID)\n+\t}\n+}\n+\n+func TestSearchNoMatch(t *testing.T) {\n+\tt.Parallel()\n+\n+\tentries := []PromptEntry{\n+\t\t{PromptText: \"fix bug\", Agent: \"claude-code\"},\n+\t}\n+\n+\tcfg := SearchConfig{Query: \"cache\"}\n+\tresults := Search(entries, cfg)\n+\n+\tif len(results) != 0 {\n+\t\tt.Errorf(\"Search() returned %d results, want 0\", len(results))\n+\t}\n+}\n+\n+func TestParseCheckpointIDPrefix(t *testing.T) {\n+\tt.Parallel()\n+\n+\ttests := []struct {\n+\t\tinput    string\n+\t\texpected string\n+\t}{\n+\t\t{\"abc123def\", \"abc123def\"},\n+\t\t{\"abc\", \"\"},                       // too short - need at least 4\n+\t\t{\"abc1234567890\", \"abc123456789\"}, // regex matches up to 12\n+\t\t{\"abcxyz\", \"\"},                    // invalid char\n+\t\t{\"123\", \"\"},                       // no letters\n+\t\t{\"\", \"\"},\n+\t\t{\"abc123\", \"abc123\"},\n+\t}\n+\n+\tfor _, tt := range tests {\n+\t\tresult := ParseCheckpointIDPrefix(tt.input)\n+\t\tif result != tt.expected {\n+\t\t\tt.Errorf(\"ParseCheckpointIDPrefix(%q) = %q, want %q\", tt.input, result, tt.expected)\n+\t\t}\n+\t}\n+}\n",
