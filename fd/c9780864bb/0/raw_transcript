48: \t}\n149: \t//nolint:gosec // G306: settings file is config, not secrets; 0o644 is appropriate\n150: \tif err := os.WriteFile(localPath, out, 0o644); err != nil {\n151: \t\treturn fmt.Errorf(\"writing local settings: %w\", err)\n152: \t}\n153: \treturn nil\n154: }\n155: \n156: // CommitMsg is called by the git commit-msg hook after the user edits the message.\n157: // If the message contains only our trailer (no actual user content), strip it\n158: // so git will abort the commit due to empty message.\n159: \n160: func (s *ManualCommitStrategy) CommitMsg(_ context.Context, commitMsgFile string) error { //nolint:unparam // error return is part of the hook contract; callers check it\n161: \tcontent, err := os.ReadFile(commitMsgFile) //nolint:gosec // Path comes from git hook\n162: \tif err != nil {\n163: \t\treturn nil //nolint:nilerr // Hook must be silent on failure\n164: \t}\n165: \n166: \tmessage := string(content)\n167: \n168: \t// Check if our trailer is present (ParseCheckpoint validates format, so found==true means valid)\n169: \tif _, found := trailers.ParseCheckpoint(message); !found {\n170: \t\t// No trailer, nothing to do\n171: \t\treturn nil\n172: \t}\n173: \n174: \t// Check if there's any user content (non-comment, non-trailer lines)\n175: \tif !hasUserContent(message) {\n176: \t\t// No user content - strip the trailer so git aborts\n177: \t\tmessage = stripCheckpointTrailer(message)\n178: \t\tif err := os.WriteFile(commitMsgFile, []byte(message), 0o600); err != nil {\n179: \t\t\treturn nil //nolint:nilerr // Hook must be silent on failure\n180: \t\t}\n181: \t}\n182: \n183: \treturn nil\n184: }\n185: \n186: // PostRewrite is called by the git post-rewrite hook after amend/rebase\n187: // operations. It keeps session linkage aligned with rewritten commit SHAs in\n188: // the current worktree.\n189: func (s *ManualCommitStrategy) PostRewrite(ctx context.Context, rewriteType string, r io.Reader) error {\n190: \tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n191: \tif rewriteType != \"amend\" && rewriteType != \"rebase\" {\n192: \t\tlogging.Debug(logCtx, \"post-rewrite: unsupported rewrite type, skipping\",\n193: \t\t\tslog.String(\"rewrite_type\", rewriteType),\n194: \t\t)\n195: \t\treturn nil\n196: \t}\n197: \n198: \trewrites, err := parsePostRewritePairs(r)\n199: \tif err != nil {\n200: \t\treturn err\n201: \t}\n202: \tif len(rewrites) == 0 {\n203: \t\treturn nil\n204: \t}\n205: \n206: \tworktreePath, err := paths.WorktreeRoot(ctx)\n207: \tif err != nil {\n208: \t\treturn nil //nolint:nilerr // Hook must be resilient\n209: \t}\n210: \n211: \tsessions, err := s.findSessionsForWorktree(ctx, worktreePath)\n212: \tif err != nil || len(sessions) == 0 {\n213: \t\treturn nil //nolint:nilerr // Hook must be resilient\n214: \t}\n215: \n216: \trepo, err := OpenRepository(ctx)\n217: \tif err != nil {\n218: \t\treturn nil //nolint:nilerr // Hook must be resilient\n219: \t}\n220: \n221: \tfor _, sess := range sessions {\n222: \t\tsessionID := sess.SessionID\n223: \t\tmutErr := MutateSessionState(ctx, sessionID, func(state *SessionState) error {\n224: \t\t\tchanged, err := s.remapSessionForRewrite(ctx, repo, state, rewrites)\n225: \t\t\tif err != nil {\n226: \t\t\t\treturn err\n227: \t\t\t}\n228: \t\t\tif !changed {\n229: \t\t\t\treturn ErrMutationSkip\n230: \t\t\t}\n231: \t\t\tlogging.Info(logCtx, \"post-rewrite: remapped session linkage\",\n232: \t\t\t\tslog.String(\"session_id\", state.SessionID),\n233: \t\t\t\tslog.String(\"rewrite_type\", rewriteType),\n234: \t\t\t\tslog.String(\"base_commit\", truncateHash(state.BaseCommit)),\n235: \t\t\t)\n236: \t\t\treturn nil\n237: \t\t})\n238: \t\tif mutErr != nil && !errors.Is(mutErr, ErrStateNotFound) {\n239: \t\t\tlogging.Warn(logCtx, \"post-rewrite: failed to remap session linkage\",\n240: \t\t\t\tslog.String(\"session_id\", sessionID),\n241: \t\t\t\tslog.String(\"error\", mutErr.Error()),\n242: \t\t\t)\n243: \t\t}\n244: \t}\n245: \n246: \treturn nil\n247: }\n248: \n249: func parsePostRewritePairs(r io.Reader) ([]rewritePair, error) {\n250: \tscanner := bufio.NewScanner(r)\n251: \tvar pairs []rewritePair\n252: \tfor scanner.Scan() {\n253: \t\tline := strings.TrimSpace(scanner.Text())\n254: \t\tif line == \"\" {\n255: \t\t\tcontinue\n256: \t\t}\n257: \t\tfields := strings.Fields(line)\n258: \t\tif len(fields) < 2 {\n259: \t\t\treturn nil, fmt.Errorf(\"invalid post-rewrite mapping line: %q\", line)\n260: \t\t}\n261: \t\tpairs = append(pairs, rewritePair{\n262: \t\t\tOldSHA: fields[0],\n263: \t\t\tNewSHA: fields[1],\n264: \t\t})\n265: \t}\n266: \tif err := scanner.Err(); err != nil {\n267: \t\treturn nil, fmt.Errorf(\"scan post-rewrite input: %w\", err)\n268: \t}\n269: \treturn pairs, nil\n270: }\n271: \n272: // hasUserContent checks if the message has any content besides comments and our trailer.\n273: func hasUserContent(message string) bool {\n274: \ttrailerPrefix := trailers.CheckpointTrailerKey + \":\"\n275: \tfor _, line := range strings.Split(message, \"\\n\") {\n276: \t\ttrimmed := strings.TrimSpace(line)\n277: \t\t// Skip empty lines\n278: \t\tif trimmed == \"\" {\n279: \t\t\tcontinue\n280: \t\t}\n281: \t\t// Skip comment lines\n282: \t\tif strings.HasPrefix(trimmed, \"#\") {\n283: \t\t\tcontinue\n284: \t\t}\n285: \t\t// Skip our trailer line\n286: \t\tif strings.HasPrefix(trimmed, trailerPrefix) {\n287: \t\t\tcontinue\n288: \t\t}\n289: \t\t// Found user content\n290: \t\treturn true\n291: \t}\n292: \treturn false\n293: }\n294: \n295: // stripCheckpointTrailer removes the Entire-Checkpoint trailer line from the message.\n296: func stripCheckpointTrailer(message string) string {\n297: \ttrailerPrefix := trailers.CheckpointTrailerKey + \":\"\n298: \tvar result []string\n299: \tfor _, line := range strings.Split(message, \"\\n\") {\n300: \t\tif !strings.HasPrefix(strings.TrimSpace(line), trailerPrefix) {\n301: \t\t\tresult = append(result, line)\n302: \t\t}\n303: \t}\n304: \treturn strings.Join(result, \"\\n\")\n305: }\n306: \n307: // isGitSequenceOperation checks if git is currently in the middle of a rebase,\n308: // cherry-pick, or revert operation. During these operations, commits are being\n309: // replayed and should not be linked to agent sessions.\n310: //\n311: // Detects:\n312: //   - rebase: .git/rebase-merge/ or .git/rebase-apply/ directories\n313: //   - cherry-pick: .git/CHERRY_PICK_HEAD file\n314: //   - revert: .git/REVERT_HEAD file\n315: func isGitSequenceOperation(ctx context.Context) bool {\n316: \t// Get git directory (handles worktrees and relative paths correctly)\n317: \tgitDir, err := GetGitDir(ctx)\n318: \tif err != nil {\n319: \t\treturn false // Can't determine, assume not in sequence operation\n320: \t}\n321: \n322: \t// Check for rebase state directories\n323: \tif _, err := os.Stat(filepath.Join(gitDir, \"rebase-merge\")); err == nil {\n324: \t\treturn true\n325: \t}\n326: \tif _, err := os.Stat(filepath.Join(gitDir, \"rebase-apply\")); err == nil {\n327: \t\treturn true\n328: \t}\n329: \n330: \t// Check for cherry-pick and revert state files\n331: \tif _, err := os.Stat(filepath.Join(gitDir, \"CHERRY_PICK_HEAD\")); err == nil {\n332: \t\treturn true\n333: \t}\n334: \tif _, err := os.Stat(filepath.Join(gitDir, \"REVERT_HEAD\")); err == nil {\n335: \t\treturn true\n336: \t}\n337: \n338: \treturn false\n339: }\n340: \n341: // PrepareCommitMsg is called by the git prepare-commit-msg hook.\n342: // Adds an Entire-Checkpoint trailer to the commit message with a stable checkpoint ID.\n343: // Only adds a trailer if there's actually new session content to condense.\n344: // The actual condensation happens in PostCommit - if the user removes the trailer,\n345: // the commit will not be linked to the session (useful for \"manual\" commits).\n346: // For amended commits, preserves the existing checkpoint ID.\n347: //\n348: // The source parameter indicates how the commit was initiated:\n349: //   - \"\" or \"template\": normal editor flow - adds trailer with explanatory comment\n350: //   - \"message\": using -m or -F flag - prompts user interactively via /dev/tty\n351: //   - \"merge\", \"squash\": skip trailer entirely (auto-generated messages)\n352: //   - \"commit\": amend operation - preserves existing trailer or restores from LastCheckpointID\n353: //\n354: \n355: func (s *ManualCommitStrategy) PrepareCommitMsg(ctx context.Context, commitMsgFile string, source string) error {\n356: \tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n357: \n358: \t// Skip during rebase, cherry-pick, or revert operations\n359: \t// These are replaying existing commits and should not be linked to agent sessions\n360: \tif isGitSequenceOperation(ctx) {\n361: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: skipped during git sequence operation\",\n362: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n363: \t\t\tslog.String(\"source\", source),\n364: \t\t)\n365: \t\treturn nil\n366: \t}\n367: \n368: \t// Skip for merge and squash sources\n369: \t// These are auto-generated messages - not from Claude sessions\n370: \tswitch source {\n371: \tcase \"merge\", \"squash\":\n372: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: skipped for source\",\n373: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n374: \t\t\tslog.String(\"source\", source),\n375: \t\t)\n376: \t\treturn nil\n377: \t}\n378: \n379: \t// Handle amend (source=\"commit\") separately: preserve or restore trailer\n380: \tif source == \"commit\" {\n381: \t\treturn s.handleAmendCommitMsg(ctx, commitMsgFile)\n382: \t}\n383: \n384: \t_, openRepoSpan := perf.Start(ctx, \"open_repository\")\n385: \trepo, err := OpenRepository(ctx)\n386: \tif err != nil {\n387: \t\topenRepoSpan.RecordError(err)\n388: \t\topenRepoSpan.End()\n389: \t\treturn nil\n390: \t}\n391: \topenRepoSpan.End()\n392: \n393: \t_, findSessionsSpan := perf.Start(ctx, \"find_sessions_for_worktree\")\n394: \tworktreePath, err := paths.WorktreeRoot(ctx)\n395: \tif err != nil {\n396: \t\tfindSessionsSpan.RecordError(err)\n397: \t\tfindSessionsSpan.End()\n398: \t\treturn nil\n399: \t}\n400: \n401: \t// Find all active sessions for this worktree\n402: \t// We match by worktree (not BaseCommit) because the user may have made\n403: \t// intermediate commits without entering new prompts, causing HEAD to diverge\n404: \tsessions, err := s.findSessionsForWorktree(ctx, worktreePath)\n405: \tif err != nil || len(sessions) == 0 {\n406: \t\tfindSessionsSpan.RecordError(err)\n407: \t\tfindSessionsSpan.End()\n408: \t\t// No active sessions or error listing - silently skip (hooks must be resilient)\n409: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: no active sessions\",\n410: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n411: \t\t\tslog.String(\"source\", source),\n412: \t\t)\n413: \t\treturn nil\n414: \t}\n415: \tfindSessionsSpan.End()\n416: \n417: \ts.warnIfAttributionDiverged(ctx, sessions)\n418: \n419: \t// Fast path: skip content detection for mid-turn agent commits.\n420: \tif s.tryAgentCommitFastPath(ctx, commitMsgFile, sessions, source) {\n421: \t\treturn nil\n422: \t}\n423: \n424: \t// Check if any session has new content to condense\n425: \t_, filterSessionsSpan := perf.Start(ctx, \"filter_sessions_with_content\")\n426: \tsessionsWithContent := s.filterSessionsWithNewContent(ctx, repo, sessions)\n427: \tfilterSessionsSpan.End()\n428: \n429: \tif len(sessionsWithContent) == 0 {\n430: \t\t// No new content — no trailer needed\n431: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: no content to link\",\n432: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n433: \t\t\tslog.String(\"source\", source),\n434: \t\t\tslog.Int(\"sessions_found\", len(sessions)),\n435: \t\t)\n436: \t\treturn nil\n437: \t}\n438: \n439: \t// Read current commit message\n440: \t_, readCommitMessageSpan := perf.Start(ctx, \"read_commit_message\")\n441: \tcontent, err := os.ReadFile(commitMsgFile) //nolint:gosec // commitMsgFile is provided by git hook\n442: \tif err != nil {\n443: \t\treadCommitMessageSpan.RecordError(err)\n444: \t\treadCommitMessageSpan.End()\n445: \t\treturn nil\n446: \t}\n447: \n448: \tmessage := string(content)\n449: \n450: \t// Check if trailer already exists (ParseCheckpoint validates format, so found==true means valid)\n451: \tif existingCpID, found := trailers.ParseCheckpoint(message); found {\n452: \t\treadCommitMessageSpan.End()\n453: \t\t// Trailer already exists (e.g., amend) - keep it\n454: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: trailer already exists\",\n455: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n456: \t\t\tslog.String(\"source\", source),\n457: \t\t\tslog.String(\"existing_checkpoint_id\", existingCpID.String()),\n458: \t\t)\n459: \t\treturn nil\n460: \t}\n461: \treadCommitMessageSpan.End()\n462: \n463: \t// Generate a fresh checkpoint ID and resolve session metadata\n464: \t_, resolveMetadataSpan := perf.Start(ctx, \"resolve_session_metadata\")\n465: \tcheckpointID, err := id.Generate()\n466: \tif err != nil {\n467: \t\tresolveMetadataSpan.RecordError(err)\n468: \t\tresolveMetadataSpan.End()\n469: \t\treturn fmt.Errorf(\"failed to generate checkpoint ID: %w\", err)\n470: \t}\n471: \n472: \t// Determine agent type and last prompt from session\n473: \tvar agentType types.AgentType\n474: \tvar lastPrompt string\n475: \tif len(sessionsWithContent) > 0 {\n476: \t\tfirstSession := sessionsWithContent[0]\n477: \t\tif firstSession.AgentType != \"\" {\n478: \t\t\tagentType = firstSession.AgentType\n479: \t\t}\n480: \t\tlastPrompt = s.getLastPrompt(ctx, repo, firstSession)\n481: \t}\n482: \n483: \t// Prepare prompt for display: collapse newlines/whitespace, then truncate (rune-safe)\n484: \tdisplayPrompt := stringutil.TruncateRunes(stringutil.CollapseWhitespace(lastPrompt), 80, \"...\")\n485: \n486: \t// Load commit_linking setting to decide whether to prompt\n487: \tcommitLinking := settings.CommitLinkingPrompt // safe default\n488: \tif stngs, loadErr := settings.Load(ctx); loadErr == nil {\n489: \t\tcommitLinking = stngs.GetCommitLinking()\n490: \t}\n491: \tresolveMetadataSpan.End()\n492: \n493: \t// Add trailer differently based on commit source\n494: \t// NOTE: TTY confirmation (askConfirmTTY) is intentionally NOT wrapped in a span\n495: \t// because it blocks on user input and would skew timing.\n496: \tswitch source {\n497: \tcase \"message\":\n498: \t\t// Using -m or -F: behavior depends on TTY availability and commit_linking setting\n499: \t\tswitch {\n500: \t\tcase !interactive.CanPromptInteractively():\n501: \t\t\t// No TTY (agent subprocess, CI) — auto-link without prompting\n502: \t\t\tmessage = addCheckpointTrailer(message, checkpointID)\n503: \t\tcase commitLinking == settings.CommitLinkingAlways:\n504: \t\t\t// User previously chose \"always\" — auto-link without prompting\n505: \t\t\tmessage = addCheckpointTrailer(message, checkpointID)\n506: \t\tdefault:\n507: \t\t\t// Human at terminal — prompt interactively\n508: \t\t\theader := \"Entire: Active \" + string(agentType) + \" session detected\"\n509: \t\t\tvar details []string\n510: \t\t\tif displayPrompt != \"\" {\n511: \t\t\t\tdetails = append(details, \"Last prompt: \"+displayPrompt)\n512: \t\t\t}\n513: \n514: \t\t\tresult := askConfirmTTY(header, details, \"Link this commit to session context?\", true)\n515: \t\t\tif result == ttyResultSkip {\n516: \t\t\t\tlogging.Debug(logCtx, \"prepare-commit-msg: user declined trailer\",\n517: \t\t\t\t\tslog.String(\"strategy\", \"manual-commit\"),\n518: \t\t\t\t\tslog.String(\"source\", source),\n519: \t\t\t\t)\n520: \t\t\t\treturn nil\n521: \t\t\t}\n522: \t\t\tif result == ttyResultLinkAlways {\n523: \t\t\t\t// Persist preference so future commits auto-link (non-fatal if it fails)\n524: \t\t\t\tif saveErr := saveCommitLinkingAlways(ctx); saveErr != nil {\n525: \t\t\t\t\tlogging.Warn(logCtx, \"prepare-commit-msg: failed to save commit_linking=always\",\n526: \t\t\t\t\t\tslog.String(\"error\", saveErr.Error()),\n527: \t\t\t\t\t)\n528: \t\t\t\t}\n529: \t\t\t}\n530: \t\t\tmessage = addCheckpointTrailer(message, checkpointID)\n531: \t\t}\n532: \tdefault:\n533: \t\t// Normal editor flow: add trailer with explanatory comment (will be stripped by git)\n534: \t\tmessage = addCheckpointTrailerWithComment(message, checkpointID, string(agentType), displayPrompt)\n535: \t}\n536: \n537: \tlogging.Info(logCtx, \"prepare-commit-msg: trailer added\",\n538: \t\tslog.String(\"strategy\", \"manual-commit\"),\n539: \t\tslog.String(\"source\", source),\n540: \t\tslog.String(\"checkpoint_id\", checkpointID.String()),\n541: \t)\n542: \n543: \t// Write updated message back\n544: \t_, writeCommitMessageSpan := perf.Start(ctx, \"write_commit_message\")\n545: \tif err := os.WriteFile(commitMsgFile, []byte(message), 0o600); err != nil { //nolint:gosec // path from git hook arg\n546: \t\twriteCommitMessageSpan.RecordError(err)\n547: \t\twriteCommitMessageSpan.End()\n548: \t\treturn nil\n549: \t}\n550: \twriteCommitMessageSpan.End()\n551: \n552: \treturn nil\n553: }\n554: \n555: // handleAmendCommitMsg handles the prepare-commit-msg hook for amend operations\n556: // (source=\"commit\"). It preserves existing trailers or restores from LastCheckpointID.\n557: func (s *ManualCommitStrategy) handleAmendCommitMsg(ctx context.Context, commitMsgFile string) error {\n558: \tlogCtx := logging.WithComponent(ctx, \"checkpoint\")\n559: \t// Read current commit message\n560: \tcontent, err := os.ReadFile(commitMsgFile) //nolint:gosec // commitMsgFile is provided by git hook\n561: \tif err != nil {\n562: \t\treturn nil //nolint:nilerr // Hook must be silent on failure\n563: \t}\n564: \n565: \tmessage := string(content)\n566: \n567: \t// If message already has a trailer, keep it unchanged\n568: \tif existingCpID, found := trailers.ParseCheckpoint(message); found {\n569: \t\tlogging.Debug(logCtx, \"prepare-commit-msg: amend preserves existing trailer\",\n570: \t\t\tslog.String(\"strategy\", \"manual-commit\"),\n571: \t\t\tslog.String(\"checkpoint_id\", existingCpID.String()),\n572: \t\t)\n573: \t\treturn nil\n574: \t}\n575: \n576: \t// No trailer in message — check if any session has LastCheckpointID to restore\n577: \tworktreePath, err := paths.WorktreeRoot(ctx)\n578: \tif err != nil {\n579: \t\treturn nil //nolint:nilerr // Hook must be silent on failure\n580: \t}\n581: \n582: \tsessions, err := s.findSessionsForWorktree(ctx, worktreePath)\n583: \tif err != nil || len(sessions) == 0 {\n584: \t\treturn nil //nolint:nilerr // No sessions - nothing to restore\n585: \t}\n586: \n587: \t// For amend, HEAD^ is the commit being amended, and HEAD is where we are now.\n588: \t// We need to match sessions whose BaseCommit equals HEAD (the commit being amended\n589: \t// was created from this base). This prevents stale sessions from injecting\n590: \t// unrelated checkpoint IDs.\n591: \trepo, repoErr := OpenRepository(ctx)\n592: \tif repoErr != nil {\n593: \t\treturn nil //nolint:nilerr // Hook must be silent on failure\n594: \t}\n595: \thead, headErr := repo.Head()\n596: \tif headErr != nil {\n597: \t\treturn nil //nolint:nilerr // Hook must be silent on failure\n598: \t}\n599: \tcurrentHead := head.Hash().String()\n600: \n601: \t// Find first matching session with LastCheckpointID to restore.\n602: \t// LastCheckpointID is set after condensation completes.\n603: \tfor _, state := range sessions {\n604: \t\tif state.BaseCommit != currentHead {\n605: \t\t\tcontinue\n606: \t\t}\n607: \t\tif state.LastCheckpointID.IsEmpty() {\n608: \t\t\tcontinue\n609: \t\t}\n610: \t\tcpID := state.LastCheckpointID\n611: \t\tsource := \"LastCheckpointID\"\n612: \n613: \t\t// Restore the trailer\n614: \t\tmessage = addCheckpointTrailer(message, cpID)\n615: \t\tif writeErr := os.WriteFile(commitMsgFile, []byte(message), 0o600); writeErr != nil { //nolint:gosec // path from git hook arg\n616: \t\t\treturn nil //nolint:nilerr // Hook must be silent on failure\n617: \t\t}\n618: \n619: \t\tlogging.Info(logCtx, \"prepare-commit-msg: restored trailer on amend\",\n620: \t\t\tslo