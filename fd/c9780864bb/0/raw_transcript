hName           string\n661: \tshadowBranchesToDelete     map[string]struct{}\n662: \tcommittedFileSet           map[string]struct{}\n663: \thasNew                     bool\n664: \tfilesTouchedBefore         []string\n665: \tsessionsWithCommittedFiles int // number of processable sessions that have tracked files\n666: \n667: \t// Cached git objects — resolved once per PostCommit invocation to avoid\n668: \t// redundant reads across filesOverlapWithContent, filesWithRemainingAgentChanges,\n669: \t// CondenseSession, and calculateSessionAttributions.\n670: \theadTree      *object.Tree        // HEAD commit tree (shared across all sessions)\n671: \tparentTree    *object.Tree        // HEAD's first parent tree (shared, nil for initial commits)\n672: \tshadowRef     *plumbing.Reference // Per-session shadow branch ref (nil if branch doesn't exist)\n673: \tshadowTree    *object.Tree        // Per-session shadow commit tree (nil if branch doesn't exist)\n674: \tallAgentFiles map[string]struct{} // Union of all sessions' FilesTouched for cross-session attribution\n675: \n676: \t// Output: set by handler methods, read by caller after TransitionAndLog.\n677: \t// condensed is true only when CondenseSession wrote data to the metadata branch.\n678: \t// Both failures and skips (no transcript/files) leave condensed=false, which\n679: \t// correctly preserves shadow branches and defers FullyCondensed marking.\n680: \tcondensed bool\n681: }\n682: \n683: // parentCommitHash returns the first parent's hash as a string, or empty for initial commits.\n684: func (h *postCommitActionHandler) parentCommitHash() string {\n685: \tif h.commit.NumParents() > 0 && len(h.commit.ParentHashes) > 0 {\n686: \t\treturn h.commit.ParentHashes[0].String()\n687: \t}\n688: \treturn \"\"\n689: }\n690: \n691: func (h *postCommitActionHandler) HandleCondense(state *session.State) error {\n692: \tlogCtx := logging.WithComponent(h.ctx, \"checkpoint\")\n693: \tshouldCondense := h.shouldCondenseWithOverlapChec