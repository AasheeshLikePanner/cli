              "patch": "Index: cmd/entire/cli/prompts/index/builder.go\n===================================================================\n--- cmd/entire/cli/prompts/index/builder.go\t\n+++ cmd/entire/cli/prompts/index/builder.go\t\n@@ -0,0 +1,313 @@\n+package index\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"fmt\"\n+\t\"io\"\n+\t\"path/filepath\"\n+\t\"strconv\"\n+\t\"strings\"\n+\t\"time\"\n+\n+\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint\"\n+\t\"github.com/entireio/cli/cmd/entire/cli/checkpoint/id\"\n+\t\"github.com/entireio/cli/cmd/entire/cli/paths\"\n+\n+\t\"github.com/go-git/go-git/v6\"\n+\t\"github.com/go-git/go-git/v6/plumbing\"\n+\t\"github.com/go-git/go-git/v6/plumbing/object\"\n+)\n+\n+const MaxPromptLength = 2000\n+\n+type IndexBuilder struct {\n+\trepo  *git.Repository\n+\tstore *IndexStore\n+}\n+\n+func NewIndexBuilder(repo *git.Repository, store *IndexStore) *IndexBuilder {\n+\treturn &IndexBuilder{repo: repo, store: store}\n+}\n+\n+func (b *IndexBuilder) Build(ctx context.Context, out io.Writer, progress func(done, total int)) error {\n+\tif err := b.store.InitIndex(); err != nil {\n+\t\treturn fmt.Errorf(\"initializing index: %w\", err)\n+\t}\n+\n+\tref, err := b.repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"getting metadata branch: %w\", err)\n+\t}\n+\n+\tcommit, err := b.repo.CommitObject(ref.Hash())\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"getting commit: %w\", err)\n+\t}\n+\n+\ttree, err := commit.Tree()\n+\tif err != nil {\n+\t\treturn fmt.Errorf(\"getting tree: %w\", err)\n+\t}\n+\n+\tvar cpIDs []id.CheckpointID\n+\t_ = walkCheckpointShards(b.repo, tree, func(cpID id.CheckpointID, _ plumbing.Hash) error {\n+\t\tcpIDs = append(cpIDs, cpID)\n+\t\treturn nil\n+\t})\n+\n+\ttotal := len(cpIDs)\n+\tallEntries := make([]PromptEntry, 0)\n+\n+\tfor i, cpID := range cpIDs {\n+\t\tentries, _ := b.loadCheckpoint(cpID)\n+\t\tallEntries = append(allEntries, entries...)\n+\t\tif progress != nil {\n+\t\t\tprogress(i+1, total)\n+\t\t}\n+\t}\n+\n+\theader := IndexHeader{\n+\t\tVersion:   CurrentIndexVersion,\n+\t\tCreatedAt: time.Now(),\n+\t\tRepoRoot:  b.store.repoRoot,\n+\t}\n+\n+\tif err := b.store.WriteAll(header, allEntries); err != nil {\n+\t\treturn fmt.Errorf(\"writing index: %w\", err)\n+\t}\n+\n+\tfmt.Fprintf(out, \"Indexed %d prompts from %d checkpoints.\\n\", len(allEntries), len(cpIDs))\n+\treturn nil\n+}\n+\n+func (b *IndexBuilder) loadCheckpoint(cpID id.CheckpointID) ([]PromptEntry, error) {\n+\tref, err := b.repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tcommit, err := b.repo.CommitObject(ref.Hash())\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\ttree, err := commit.Tree()\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tcpPath := cpID.Path()\n+\tcpTree, err := tree.Tree(cpPath)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"checkpoint tree not found: %w\", err)\n+\t}\n+\n+\tmetaFile, err := cpTree.File(paths.MetadataFileName)\n+\tif err != nil {\n+\t\treturn nil, fmt.Errorf(\"reading checkpoint metadata: %w\", err)\n+\t}\n+\tmetaContent, err := metaFile.Contents()\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tvar summary checkpoint.CheckpointSummary\n+\tif err := json.Unmarshal([]byte(metaContent), &summary); err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tentries := make([]PromptEntry, 0, len(summary.Sessions))\n+\n+\tfor i, sessionPaths := range summary.Sessions {\n+\t\tsessionEntries, err := b.loadSession(cpID, i, sessionPaths, summary)\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tentries = append(entries, sessionEntries...)\n+\t}\n+\n+\treturn entries, nil\n+}\n+\n+func (b *IndexBuilder) loadSession(cpID id.CheckpointID, sessionIndex int, sessionPaths checkpoint.SessionFilePaths, summary checkpoint.CheckpointSummary) ([]PromptEntry, error) {\n+\tref, err := b.repo.Reference(plumbing.NewBranchReferenceName(paths.MetadataBranchName), true)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tcommit, err := b.repo.CommitObject(ref.Hash())\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\ttree, err := commit.Tree()\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tcpTree, err := tree.Tree(cpID.Path())\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tsessionDir := strconv.Itoa(sessionIndex)\n+\tsessionTree, err := cpTree.Tree(sessionDir)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\n+\tvar metadata checkpoint.CommittedMetadata\n+\tif metaFile, err := sessionTree.File(paths.MetadataFileName); err == nil {\n+\t\tif metaContent, err := metaFile.Contents(); err == nil {\n+\t\t\tjson.Unmarshal([]byte(metaContent), &metadata)\n+\t\t}\n+\t}\n+\n+\tvar promptText string\n+\tvar promptTruncated bool\n+\tif promptFile, err := sessionTree.File(paths.PromptFileName); err == nil {\n+\t\tif content, err := promptFile.Contents(); err == nil {\n+\t\t\tif len(content) > MaxPromptLength {\n+\t\t\t\tpromptText = content[:MaxPromptLength]\n+\t\t\t\tpromptTruncated = true\n+\t\t\t} else {\n+\t\t\t\tpromptText = content\n+\t\t\t}\n+\t\t}\n+\t}\n+\n+\tturns := splitMultiTurn(promptText)\n+\tentries := make([]PromptEntry, 0, len(turns))\n+\n+\tfor turnIdx, turnText := range turns {\n+\t\tif strings.TrimSpace(turnText) == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tentries = append(entries, PromptEntry{\n+\t\t\tCheckpointID:     string(cpID),\n+\t\t\tSessionIndex:     sessionIndex,\n+\t\t\tTurnIndex:        turnIdx,\n+\t\t\tKind:             metadata.Kind,\n+\t\t\tPromptText:       turnText,\n+\t\t\tPromptTruncated:  promptTruncated && turnIdx == len(turns)-1,\n+\t\t\tCommitHash:       \"\",\n+\t\t\tCommitMessage:    \"\",\n+\t\t\tBranch:           summary.Branch,\n+\t\t\tAgent:            string(metadata.Agent),\n+\t\t\tModel:            metadata.Model,\n+\t\t\tTokenCount:       0,\n+\t\t\tFilesTouched:     summary.FilesTouched,\n+\t\t\tCreatedAt:        metadata.CreatedAt,\n+\t\t})\n+\t}\n+\n+\treturn entries, nil\n+}\n+\n+func splitMultiTurn(promptContent string) []string {\n+\tif strings.TrimSpace(promptContent) == \"\" {\n+\t\treturn nil\n+\t}\n+\tturns := strings.Split(promptContent, \"\\n\\n---\\n\\n\")\n+\tresult := make([]string, 0, len(turns))\n+\tfor _, turn := range turns {\n+\t\tif trimmed := strings.TrimSpace(turn); trimmed != \"\" {\n+\t\t\tresult = append(result, trimmed)\n+\t\t}\n+\t}\n+\tif len(result) == 0 {\n+\t\treturn []string{promptContent}\n+\t}\n+\treturn result\n+}\n+\n+func walkCheckpointShards(repo *git.Repository, tree plumbing.Object, fn func(id.CheckpointID, plumbing.Hash) error) error {\n+\trootTree, ok := tree.(*object.Tree)\n+\tif !ok {\n+\t\treturn fmt.Errorf(\"not a tree object\")\n+\t}\n+\n+\tfor _, shardEntry := range rootTree.Entries {\n+\t\tif !shardEntry.Mode.IsDir() || len(shardEntry.Name) != 2 || !isHex(shardEntry.Name) {\n+\t\t\tcontinue\n+\t\t}\n+\n+\t\tshardTree, err := repo.TreeObject(shardEntry.Hash)\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\n+\t\tfor _, cpEntry := range shardTree.Entries {\n+\t\t\tif !cpEntry.Mode.IsDir() || len(cpEntry.Name) != 10 || !isHex(cpEntry.Name) {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\n+\t\t\tfullID := shardEntry.Name + cpEntry.Name\n+\t\t\tcpID, err := id.NewCheckpointID(fullID)\n+\t\t\tif err != nil {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\n+\t\t\tif err := fn(cpID, cpEntry.Hash); err != nil {\n+\t\t\t\treturn err\n+\t\t\t}\n+\t\t}\n+\t}\n+\n+\treturn nil\n+}\n+\n+func isHex(s string) bool {\n+\tfor _, c := range s {\n+\t\tif !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn len(s) > 0\n+}\n+\n+type SessionData struct {\n+\tPromptText    string\n+\tKind          string\n+\tCommitHash    string\n+\tCommitMessage string\n+\tBranch        string\n+\tAgent         string\n+\tModel         string\n+\tTokenCount    int\n+\tFilesTouched  []string\n+\tCreatedAt     time.Time\n+}\n+\n+func (b *IndexBuilder) AppendFromCheckpoint(ctx context.Context, cpID string, sessionIndex int, data SessionData) error {\n+\ttruncated := false\n+\tpromptText := data.PromptText\n+\tif len(promptText) > MaxPromptLength {\n+\t\tpromptText = promptText[:MaxPromptLength]\n+\t\ttruncated = true\n+\t}\n+\n+\tturns := splitMultiTurn(promptText)\n+\tfor turnIdx, turnText := range turns {\n+\t\tif strings.TrimSpace(turnText) == \"\" {\n+\t\t\tcontinue\n+\t\t}\n+\t\tentry := PromptEntry{\n+\t\t\tCheckpointID:    cpID,\n+\t\t\tSessionIndex:     sessionIndex,\n+\t\t\tTurnIndex:        turnIdx,\n+\t\t\tKind:             data.Kind,\n+\t\t\tPromptText:       turnText,\n+\t\t\tPromptTruncated:  truncated && turnIdx == len(turns)-1,\n+\t\t\tCommitHash:       data.CommitHash,\n+\t\t\tCommitMessage:    data.CommitMessage,\n+\t\t\tBranch:           data.Branch,\n+\t\t\tAgent:            data.Agent,\n+\t\t\tModel:            data.Model,\n+\t\t\tTokenCount:       data.TokenCount,\n+\t\t\tFilesTouched:     data.FilesTouched,\n+\t\t\tCreatedAt:        data.CreatedAt,\n+\t\t}\n+\t\tif err := b.store.AppendEntry(entry); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\treturn nil\n+}\n\\ No newline at end of file\n",
