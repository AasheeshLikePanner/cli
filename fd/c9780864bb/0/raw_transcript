sink in TTY mode.\n77: \t// Production wiring resolves the same provider entire explain uses.\n78: \t// When nil, the synthesis sink is not appended and synthesis is unavailable.\n79: \tSynthesisProvider SynthesisProvider\n80: \n81: \t// PromptYN overrides the y/N confirmation form used by SynthesisSink.\n82: \t// Nil means the real huh form is used (realPromptYN in synthesis_sink.go).\n83: \t// Tests inject a stub to avoid TTY interactions.\n84: \tPromptYN func(ctx context.Context, question string, def bool) (bool, error)\n85: }\n86: \n87: // runReviewDeps carries the subset of Deps that runReview itself reads\n88: // directly (vs. NewCommand's wiring). Kept unexported so tests construct a\n89: // Deps value at the package boundary; runReview unpacks the relevant fields.\n90: type runReviewDeps struct {\n91: \tpromptForAgentFn func(ctx context.Context, eligible []AgentChoice) (string, error)\n92: \tmultiPickerFn    func(ctx context.Context, eligible []AgentChoice) (PickedAgents, error)\n93: }\n94: \n95: // NewCommand returns the `entire review` cobra command wired with the\n96: // provided deps. Callers in the cli package pass a fully-populated Deps;\n97: // tests pass a Deps with stub fields.\n98: func NewCommand(deps Deps) *cobra.Command {\n99: \tvar edit bool\n100: \tvar agentOverride string\n101: \tvar findings bool\n102: \tvar fix bool\n103: \tvar all bool\n104: \n105: \tcmd := &cobra.Command{\n106: \t\tUse: \"review\",\n107: \t\t// Hidden from `entire help` while the feature is still maturing —\n108: \t\t// users who know about it can still run `entire review` / `entire\n109: \t\t// review --help` and the command works normally.\n110: \t\tHidden: true,\n111: \t\tShort:  \"Run configured review skills against the current branch\",\n112: \t\tLong: `Run the review skills configured in .entire/settings.json against\n113: the current branch. On first run, an interactive picker writes the config.\n114: \n115: Labs entry: review is experimental. We are actively refining it based on user\n116: feedback.\n117: \n118: The review session is recorded as part of the next checkpoint, so the\n119: review metadata is permanently attached to the commit it covers.\n120: \n121: Flags:\n122:   --edit         re-open the review config picker\n123:   --findings     browse local review findings\n124:   --fix          apply review findings in a normal agent session\n125:   --all          with --fix, apply all sources/findings without selectors\n126:   --agent NAME   select a specific configured agent when more than one is\n127:                  configured (default: alphabetically first)\n128: \n129: Subcommands:\n130:   attach <id>    tag an existing session as a review (equivalent to\n131:                  'entire attach --review <id>')`,\n132: \t\tArgs: func(_ *cobra.Command, args []string) error {\n133: \t\t\tif len(args) > 1 {\n134: \t\t\t\treturn fmt.Errorf(\"accepts at most one review session id, received %d\", len(args))\n135: \t\t\t}\n136: \t\t\tif len(args) == 1 && !fix {\n137: \t\t\t\treturn errors.New(\"review session id is only valid with --fix\")\n138: \t\t\t}\n139: \t\t\treturn nil\n140: \t\t},\n141: \t\tRunE: func(cmd *cobra.Command, args []string) error {\n142: \t\t\tctx := cmd.Context()\n143: \t\t\t// Discover external agents so review configs that target them\n144: \t\t\t// resolve correctly — without this, GetAgentsWithHooksInstalled\n145: \t\t\t// and agent.Get can't see them.\n146: \t\t\texternal.DiscoverAndRegister(ctx)\n147: \n148: \t\t\tif all && !fix {\n149: \t\t\t\treturn errors.New(\"--all requires --fix\")\n150: \t\t\t}\n151: \t\t\tmodes := 0\n152: \t\t\tfor _, enabled := range []bool{edit, findings, fix} {\n153: \t\t\t\tif enabled {\n154: \t\t\t\t\tmodes++\n155: \t\t\t\t}\n156: \t\t\t}\n157: \t\t\tif modes > 1 {\n158: \t\t\t\treturn errors.New(\"--edit, --findings, and --fix are mutually exclusive\")\n159: \t\t\t}\n160: \t\t\tif edit {\n161: \t\t\t\t_, err := RunReviewConfigPicker(ctx, cmd.OutOrStdout(), deps.GetAgentsWithHooksInstalled)\n162: \t\t\t\treturn err\n163: \t\t\t}\n164: \t\t\tif findings {\n165: \t\t\t\treturn runReviewFindings(ctx, cmd, deps.NewSilentError)\n166: \t\t\t}\n167: \t\t\tif fix {\n168: \t\t\t\ttarget := \"\"\n169: \t\t\t\tif len(args) == 1 {\n170: \t\t\t\t\ttarget = args[0]\n171: \t\t\t\t}\n172: \t\t\t\treturn runReviewFix(ctx, cmd, target, all, agentOverride, deps.NewSilentError)\n173: \t\t\t}\n174: \t\t\tinnerDeps := runReviewDeps{\n175: \t\t\t\tpromptForAgentFn: deps.PromptForAgentFn,\n176: \t\t\t\tmultiPickerFn:    deps.MultiPickerFn,\n177: \t\t\t}\n178: \t\t\treturn runReview(ctx, cmd, agentOverride, deps, innerDeps)\n179: \t\t},\n180: \t}\n181: \tcmd.Flags().BoolVar(&edit, \"edit\", false, \"re-open the review config picker\")\n182: \tcmd.Flags().BoolVar(&findings, \"findings\", false, \"browse local review findings\")\n183: \tcmd.Flags().BoolVar(&fix, \"fix\", false, \"apply review findings in a normal agent session\")\n184: \tcmd.Flags().BoolVar(&all, \"all\", false, \"with --fix, apply all sources/findings without selectors\")\n185: \tcmd.Flags().StringVar(&agentOverride, \"agent\", \"\", \"select a specific configured agent (default: alphabetically first)\")\n186: \tif deps.AttachCmd != nil {\n187: \t\tcmd.AddCommand(deps.AttachCmd)\n188: \t}\n189: \treturn cmd\n190: }\n191: \n192: // runReview executes the main review flow.\n193: func runReview(ctx context.Context, cmd *cobra.Command, agentOverride string, deps Deps, innerDeps runReviewDeps) error {\n194: \tout := cmd.OutOrStdout()\n195: \tsilentErr := deps.NewSilentError\n196: \n197: \t// 1. Pre-flight: must be in a git repo.\n198: \tif _, err := paths.WorktreeRoot(ctx); err != nil {\n199: \t\tcmd.SilenceUsage = true\n200: \t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Not a git repository. Run `entire enable` first.\")\n201: \t\treturn silentErr(errors.New(\"not a git repository\"))\n202: \t}\n203: \n204: \t// 2. Load config. A load error means the settings file exists but is\n205: \t// malformed (Load returns a default-filled object when the file is\n206: \t// missing). Surface the error instead of silently opening the picker,\n207: \t// which would cause SaveReviewConfig to write over the user's other\n208: \t// settings with an empty EntireSettings{}.\n209: \ts, err := settings.Load(ctx)\n210: \tif err != nil {\n211: \t\tcmd.SilenceUsage = true\n212: \t\tfmt.Fprintf(cmd.ErrOrStderr(), \"Failed to load settings: %v\\n\", err)\n213: \t\tfmt.Fprintln(cmd.ErrOrStderr(), \"Fix `.entire/settings.json` and re-run `entire review`.\")\n214: \t\treturn silentErr(err)\n215: \t}\n216: \tif s == nil || len(s.Review) == 0 {\n217: \t\tif !ConfirmFirstRunSetup(ctx, out) {\n218: \t\t\treturn nil\n219: \t\t}\n220: \t\tpicked, pickErr := RunReviewConfigPicker(ctx, out, deps.GetAgentsWithHooksInstalled)\n221: \t\tif pickErr != nil {\n222: \t\t\treturn pickErr\n223: \t\t}\n224: \t\tif s == nil {\n225: \t\t\ts = &settings.EntireSettings{}\n226: \t\t}\n227: \t\ts.Review = picked\n228: \t\tfmt.Fprintln(out)\n229: \t\tfmt.Fprintln(out, \"Setup complete — running review now.\")\n230: \t}\n231: \n232: \t// 3. Resolve installed agents and determine the dispatch path.\n233: \t//\n234: \t// Three paths:\n235: \t//   - Multi-agent: 2+ launchable eligible agents AND no --agent override →\n236: \t//     show multi-select picker then RunMulti. Steps 3.5, 3.6, and the\n237: \t//     single-agent skill-verify guard are skipped; each reviewer pulls\n238: \t//     its own skills from settings at spawn time via RunConfig.\n239: \t//   - Single-agent (default): 1 or fewer launchable eligible agents, OR\n240: \t//     --agent override set. Falls through to the full agent-selection and\n241: \t//     validation path below (steps 3–3.6).\n242: \tinstalled := deps.GetAgentsWithHooksInstalled(ctx)\n243: \tif agentOverride == \"\" {\n244: \t\tlaunchableEligible := computeLaunchableEligible(s, installed, deps.ReviewerFor)\n245: \t\tif len(launchableEligible) >= 2 {\n246: \t\t\treturn runMultiAgentPath(ctx, cmd, launchableEligible, s, innerDeps, deps, out)\n247: \t\t}\n248: \t}\n249: \n250: \t// Single-agent path: pick agent, verify hooks + skills, scope, run.\n251: \n252: \t// 3a. Base selection on the eligible set (configured AND installed):\n253: \t//   - 0 eligible: fall through; SelectReviewAgent below errors with the\n254: \t//     full configured map (clearer \"no installed agent\" diagnostic than\n255: \t//     a silent fail).\n256: \t//   - 1 eligible: use it directly. This matters when the alphabetically-\n257: \t//     first configured agent isn't installed but exactly one other is —\n258: \t//     without this, SelectReviewAgent would default to the alphabetical\n259: \t//     first and the verify-hooks check below would error needlessly.\n260: \t//   - 2+ eligible: prompt with single-select (non-launchable agents reach\n261: \t//     this branch since computeLaunchableEligible filtered them out above).\n262: \tif agentOverride == \"\" {\n263: \t\teligible := ComputeEligibleConfigured(s, installed)\n264: \t\tswitch {\n265: \t\tcase len(eligible) == 1:\n266: \t\t\tagentOverride = eligible[0].Name\n267: \t\tcase len(eligible) > 1:\n268: \t\t\tfn := innerDeps.promptForAgentFn\n269: \t\t\tif fn == nil {\n270: \t\t\t\tfn = PromptForAgent\n271: \t\t\t}\n272: \t\t\tpicked, pickErr := fn(ctx, eligible)\n273: \t\t\tif pickErr != nil {\n274: \t\t\t\tcmd.SilenceUsage = true\n275: \t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n276: \t\t\t\treturn silentErr(pickErr)\n277: \t\t\t}\n278: \t\t\tif picked == \"\" {\n279: \t\t\t\t// Defensive: empty picker return must not fall through to\n280: \t\t\t\t// alphabetical-first default.\n281: \t\t\t\tcmd.SilenceUsage = true\n282: \t\t\t\temptyErr := errors.New(\"agent picker returned empty agent name\")\n283: \t\t\t\tfmt.Fprintln(cmd.ErrOrStderr(), emptyErr.Error())\n284: \t\t\t\treturn silentErr(emptyErr)\n285: \t\t\t}\n286: \t\t\tagentOverride = picked\n287: \t\t}\n288: \t}\n289: \n290: \tagentName, cfg, err := SelectReviewAgent(s.Review, agentOverride)\n291: \tif err != nil {\n292: \t\tcmd.SilenceUsage = true\n293: \t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n294: \t\treturn silentErr(err)\n295: \t}\n296: \n297: \treturn runSingleAgentPath(ctx, cmd, agentName, cfg, installed, deps, out)\n298: }\n299: \n300: // runSingleAgentPath completes a single-agent review: verifies hooks + skills,\n301: // guards against re-review, resolves scope, then dispatches via Run or\n302: // RunMarkerFallback.\n303: func runSingleAgentPath(\n304: \tctx context.Context,\n305: \tcmd *cobra.Command,\n306: \tagentName string,\n307: \tcfg settings.ReviewConfig,\n308: \tinstalled []types.AgentName,\n309: \tdeps Deps,\n310: \tout io.Writer,\n311: ) error {\n312: \tsilentErr := deps.NewSilentError\n313: \n314: \t// 3.5. Verify hooks are installed for the selected agent.\n315: \tfound := false\n316: \tfor _, n := range installed {\n317: \t\tif string(n) == agentName {\n318: \t\t\tfound = true\n319: \t\t\tbreak\n320: \t\t}\n321: \t}\n322: \tif !found {\n323: \t\tcmd.SilenceUsage = true\n324: \t\tfmt.Fprintf(cmd.ErrOrStderr(),\n325: \t\t\t\"Hooks are not installed for %q. Run `entire configure --agent %s` first, \"+\n326: \t\t\t\t\"or remove %q from review settings.\\n\",\n327: \t\t\tagentName, agentName, agentName)\n328: \t\treturn silentErr(fmt.Errorf(\"hooks not installed for %s\", agentName))\n329: \t}\n330: \n331: \t// 3.6. Verify configured skills are actually installed on disk.\n332: \tag, agErr := agent.Get(types.AgentName(agentName))\n333: \tif agErr != nil {\n334: \t\treturn fmt.Errorf(\"resolve agent %s: %w\", agentName, agErr)\n335: \t}\n336: \tif err := VerifyConfiguredSkillsInstalled(ctx, ag, cfg); err != nil {\n337: \t\tcmd.SilenceUsage = true\n338: \t\tfmt.Fprintln(cmd.ErrOrStderr(), err.Error())\n339: \t\treturn silentErr(err)\n340: \t}\n341: \n342: \t// 4. Re-run guard: check if HEAD's checkpoint already has a review.\n343: \tif reviewed, meta := deps.HeadHasReviewCheckpoint(ctx); reviewed {\n344: \t\tvar proceed bool\n345: \t\tform := newAccessibleForm(huh.NewGroup(\n346: \t\t\thuh.NewConfirm().\n347: \t\t\t\tTitle(fmt.Sprintf(\"Already reviewed: %s. Proceed anyway?\", meta)).\n348: \t\t\t\tValue(&proceed),\n349: \t\t))\n350: \t\tif err := form.RunWithContext(ctx); err != nil {\n351: \t\t\tfmt.Fprintln(out, \"prompt cancelled\")\n352: \t\t\treturn err //nolint:wrapcheck // propagate huh cancellation\n353: \t\t}\n354: \t\tif !proceed {\n355: \t\t\tfmt.Fprintln(out, \"Review cancelled.\")\n356: \t\t\treturn nil\n357: \t\t}\n358: \t}\n359: \n360: \t// 5. Resolve HEAD SHA and worktree root.\n361: \tworktreeRoot, err := paths.WorktreeRoot(ctx)\n362: \tif err != nil {\n363: \t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n364: \t}\n365: \n366: \t// 6. Resolve HEAD SHA and detect scope.\n367: \theadSHA, shaErr := currentHeadSHA(ctx, worktreeRoot)\n368: \tif shaErr != nil {\n369: \t\treturn fmt.Errorf(\"resolve HEAD: %w\", shaErr)\n370: \t}\n371: \tscopeBaseRef := detectScope(ctx, worktreeRoot, out)\n372: \tcheckpointContext := \"\"\n373: \tif deps.ReviewCheckpointContext != nil {\n374: \t\tcheckpointContext = deps.ReviewCheckpointContext(ctx, worktreeRoot, scopeBaseRef)\n375: \t}\n376: \n377: \trunCfg := reviewtypes.RunConfig{\n378: \t\tScopeBaseRef:      scopeBaseRef,\n379: \t\tCheckpointContext: checkpointContext,\n380: \t\tStartingSHA:       headSHA,\n381: \t}\n382: \tapplyReviewConfig(&runCfg, cfg)\n383: \n384: \t// 7. Branch on launchability.\n385: \treviewer := deps.ReviewerFor(agentName)\n386: \tif reviewer == nil {\n387: \t\t// Non-launchable: write marker (with scope-aware prompt) and print guidance.\n388: \t\treturn RunMarkerFallback(ctx, agentName, runCfg, worktreeRoot, out)\n389: \t}\n390: \n391: \trunCtx, cancelRun := context.WithCancel(ctx)\n392: \tdefer cancelRun()\n393: \n394: \tcanPrompt := interactive.CanPromptInteractively()\n395: \tsinks := composeSingleAgentSinks(singleAgentSinkInputs{\n396: \t\tout:       out,\n397: \t\tisTTY:     interactive.IsTerminalWriter(out) && canPrompt,\n398: \t\tcanPrompt: canPrompt,\n399: \t\tagentName: agentName,\n400: \t\tcancelRun: cancelRun,\n401: \t})\n402: \tif tuiSink, ok := findTUISink(sinks); ok {\n403: \t\ttuiSink.Start()\n404: \t\tdefer tuiSink.Wait()\n405: \t}\n406: \n407: \tsummary, waitErr := Run(runCtx, reviewer, runCfg, sinks)\n408: \twritePostReviewManifest(ctx, out, worktreeRoot, headSHA, summary, \"\")\n409: \tif waitErr != nil && runCtx.Err() == nil && ctx.Err() == nil {\n410: \t\t// Non-cancellation error: surface to caller.\n411: \t\treturn fmt.Errorf(\"review run: %w\", waitErr)\n412: \t}\n413: \treturn nil\n414: }\n415: \n416: // detectScope computes the scope base ref for the current repo and prints a\n417: // scope banner to out on success. Best-effort: on any failure, returns an\n418: // empty string and prints no banner so the run proceeds in degraded mode.\n419: func detectScope(ctx context.Context, worktreeRoot string, out io.Writer) (scopeBaseRef string) {\n420: \tif repo, openErr := git.PlainOpen(worktreeRoot); openErr == nil {\n421: \t\tif stats, statsErr := ComputeScopeStats(ctx, repo); statsErr == nil {\n422: \t\t\tfmt.Fprintln(out, formatScopeBanner(stats))\n423: \t\t\treturn stats.BaseRef\n424: \t\t} else { //nolint:revive // else-after-return is clearer here for the error-path log\n425: \t\t\tlogging.Debug(ctx, \"review scope detection failed\", slog.String(\"error\", statsErr.Error()))\n426: \t\t}\n427: \t} else {\n428: \t\tlogging.Debug(ctx, \"review repo open failed\", slog.String(\"error\", openErr.Error()))\n429: \t}\n430: \treturn \"\"\n431: }\n432: \n433: // runMultiAgentPath handles the multi-agent review flow: shows the multi-select\n434: // picker, collects an optional per-run prompt, builds per-agent RunConfigs,\n435: // then runs all selected agents concurrently via RunMulti.\n436: //\n437: // This path skips the single-agent validation steps (3.5 hooks, 3.6 skills,\n438: // re-run guard) for brevity — computeLaunchableEligible has already ensured\n439: // each eligible agent has hooks installed and a Reviewer available.\n440: func runMultiAgentPath(\n441: \tctx context.Context,\n442: \tcmd *cobra.Command,\n443: \tlaunchableEligible []AgentChoice,\n444: \ts *settings.EntireSettings,\n445: \tinnerDeps runReviewDeps,\n446: \tdeps Deps,\n447: \tout io.Writer,\n448: ) error {\n449: \t// Note: skill verification is intentionally skipped here. The\n450: \t// computeLaunchableEligible filter in the dispatch fork already\n451: \t// guarantees every agent in launchableEligible has hooks installed\n452: \t// AND a non-nil ReviewerFor mapping, so a per-agent verify pass would\n453: \t// be redundant.\n454: \tsilentErr := deps.NewSilentError\n455: \n456: \t// Show multi-select picker (or use injected stub in tests).\n457: \tpickerFn := innerDeps.multiPickerFn\n458: \tif pickerFn == nil {\n459: \t\tpickerFn = PickAgents\n460: \t}\n461: \tpicked, pickErr := pickerFn(ctx, launchableEligible)\n462: \tif pickErr != nil {\n463: \t\treturn handlePickerError(cmd, silentErr, pickErr)\n464: \t}\n465: \n466: \t// Resolve worktree root and HEAD SHA for scope detection.\n467: \tworktreeRoot, err := paths.WorktreeRoot(ctx)\n468: \tif err != nil {\n469: \t\treturn fmt.Errorf(\"resolve worktree root: %w\", err)\n470: \t}\n471: \theadSHA, shaErr := currentHeadSHA(ctx, worktreeRoot)\n472: \tif shaErr != nil {\n473: \t\treturn fmt.Errorf(\"resolve HEAD: %w\", shaErr)\n474: \t}\n475: \n476: \tscopeBaseRef := detectScope(ctx, worktreeRoot, out)\n477: \tcheckpointContext := \"\"\n478: \tif deps.ReviewCheckpointContext != nil {\n479: \t\tcheckpointContext = deps.ReviewCheckpointContext(ctx, worktreeRoot, scopeBaseRef)\n480: \t}\n481: \n482: \t// Build per-agent reviewers with individual RunConfigs (each agent has\n483: \t// its own skills + always-prompt from s.Review[name]).\n484: \treviewers := make([]reviewtypes.AgentReviewer, 0, len(picked.Names))\n485: \tfor _, name := range picked.Names {\n486: \t\tagentCfg := s.Review[name] // zero value is safe (empty skills/prompt)\n487: \t\treviewer := deps.ReviewerFor(name)\n488: \t\tif reviewer == nil {\n489: \t\t\t// Shouldn't happen given launchableEligible was filtered for\n490: \t\t\t// ReviewerFor != nil, but be defensive.\n491: \t\t\tcmd.SilenceUsage = true\n492: \t\t\treturn silentErr(fmt.Errorf(\"agent %q is not launchable but appeared in eligible list\", name))\n493: \t\t}\n494: \t\t// Wrap the reviewer so it sees the per-agent RunConfig at Start time.\n495: \t\t// We cannot pass a different RunConfig per reviewer in RunMulti's\n496: \t\t// current API (all reviewers share one RunConfig). Instead, build a\n497: \t\t// configuredReviewer adapter that injects per-agent skills into\n498: \t\t// RunConfig before forwarding to the underlying reviewer.\n499: \t\treviewers = append(reviewers, &perAgentConfiguredReviewer{\n500: \t\t\tinner: reviewer,\n501: \t\t\tcfg: runConfigWithReviewConfig(reviewtypes.RunConfig{\n502: \t\t\t\tPerRunPrompt:      picked.PerRun,\n503: \t\t\t\tScopeBaseRef:      scopeBaseRef,\n504: \t\t\t\tCheckpointContext: checkpointContext,\n505: \t\t\t\tStartingSHA:       headSHA,\n506: \t\t\t}, agentCfg),\n507: \t\t})\n508: \t}\n509: \n510: \t// Compose sinks based on TTY detection.\n511: \t// TTY mode: [TUISink, DumpSink] — TUI owns the live dashboard; DumpSink\n512: \t// renders the post-run narrative after TUI dismisses (RunFinished is called\n513: \t// on each sink in order, and TUISink.RunFinished blocks until user dismisses).\n514: \t// Non-TTY mode: [DumpSink] alone.\n515: \t//\n516: \t// A derived context is used so the TUI's Ctrl+C handler can cancel the run\n517: \t// via the same cancelRun function that the orchestrator's context is built on.\n518: \trunCtx, cancelRun := context.WithCancel(ctx)\n519: \tdefer cancelRun()\n520: \n521: \tagentNames := make([]string, len(reviewers))\n522: \tfor i, r := range reviewers {\n523: \t\tagentNames[i] = r.Name()\n524: \t}\n525: \taggregateOutput := \"\"\n526: \n527: \t// TUI requires both:\n528: \t//   - terminal stdout (otherwise ANSI codes corrupt redirected output)\n529: \t//   - a promptable stdin (otherwise the post-run dismissal loop blocks\n530: \t//     forever — happens when entire review is invoked from inside an\n531: \t//     agent like Claude Code or Gemini CLI, where stdout is a TTY but\n532: \t//     keypresses are never delivered)\n533: \tsinks := composeMultiAgentSinks(multiAgentSinkInputs{\n534: \t\tout:               out,\n535: \t\tisTTY:             interactive.IsTerminalWriter(out) && interactive.CanPromptInteractively(),\n536: \t\tcanPrompt:         interactive.CanPromptInteractively(),\n537: \t\tagentNames:        agentNames,\n538: \t\tcancelRun:         cancelRun,\n539: \t\trunContext:        runCtx,\n540: \t\tsynthesisProvider: deps.SynthesisProvider,\n541: \t\tpromptYN:          deps.PromptYN,\n542: \t\tperRunPrompt:      picked.PerRun,\n543: \t\tonSynthesisResult: func(result string) {\n544: \t\t\taggregateOutput = result\n545: \t\t},\n546: \t})\n547: \tif tuiSink, ok := findTUISink(sinks); ok {\n548: \t\ttuiSink.Start()\n549: \t\tdefer tuiSink.Wait()\n550: \t}\n551: \n552: \tsummary, waitErr := RunMulti(runCtx, reviewers, reviewtypes.RunConfig{}, sinks)\n553: \twritePostReviewManifest(ctx, out, worktreeRoot, headSHA, summary, aggregateOutput)\n554: \tif waitErr != nil && runCtx.Err() == nil && ctx.Err() == nil {\n555: \t\treturn fmt.Errorf(\"review run: %w\", waitErr)\n556: \t}\n557: \treturn nil\n558: }\n559: \n560: // handlePickerError maps multi-picker error sentinels to the appropriate\n561: // command-layer response.\n562: //   - ErrPickerCancelled → return nil (user cancelled; no error shown)\n563: //   - ErrNoAgentsSelected → surface error to user\n564: //   - other errors → surface to user\n565: func handlePickerError(cmd *cobra.Command, silentErr func(error) error, pickErr error) error {\n566: \tif errors.Is(pickErr, ErrPickerCancelled) {\n567: \t\treturn nil\n568: \t}\n569: \tcmd.SilenceUsage = true\n570: \tfmt.Fprintln(cmd.ErrOrStderr(), pickErr.Error())\n571: \treturn silentErr(pickErr)\n572: }\n573: \n574: // multiAgentSinkInputs collects the parameters composeMultiAgentSinks needs.\n575: // It exists so tests can drive the helper with explicit isTTY / canPrompt\n576: // values instead of monkey-patching interactive helpers at run time.\n577: //\n578: // isTTY here means \"the TUI sink is safe to compose\" — production callers\n579: // AND IsTerminalWriter(out) with CanPromptInteractively() before passing\n580: // it in, since the TUI both writes ANSI to stdout AND reads keypresses\n581: // from stdin. A terminal-stdout-but-non-interactive-stdin scenario (an\n582: // agent host like Claude Code invoking `entire review`) must NOT use the\n583: // TUI — its dismissal loop would block forever.\n584: type multiAgentSinkInputs struct {\n585: \tout               io.Writer\n586: \tisTTY             bool\n587: \tcanPrompt         bool\n588: \tagentNames        []string\n589: \tcancelRun         context.CancelFunc\n590: \trunContext        context.Context\n591: \tsynthesisProvider SynthesisProvider\n592: \tpromptYN          func(ctx context.Context, question string, def bool) (bool, error)\n593: \tperRunPrompt      string\n594: \tonSynthesisResult func(result string)\n595: }\n596: \n597: type singleAgentSinkInputs struct {\n598: \tout       io.Writer\n599: \tisTTY     bool\n600: \tcanPrompt bool\n601: \tagentName string\n602: \tcancelRun context.CancelFunc\n603: }\n604: \n605: // composeMultiAgentSinks builds the sink slice for a multi-agent run.\n606: //\n607: //   - Non-TTY: [DumpSink] alone — narrative dump only, no live UI, no prompts.\n608: //   - TTY: [TUISink, DumpSink, SynthesisSink?] — TUI owns the live dashboard;\n609: //     DumpSink renders the post-run narrative; SynthesisSink (if a provider is\n610: //     configured AND stdin can prompt) appends the y/N synthesis offer.\n611: //\n612: // The synthesis sink is only appended when canPrompt is true: without a\n613: // promptable stdin, the y/N form would never resolve. SynthesisSink also\n614: // guards on InputTTY internally (defense in depth) but suppressing it here\n615: // avoids constructing a sink that will silently no-op.\n616: func composeMultiAgentSinks(in multiAgentSinkInputs) []reviewtypes.Sink {\n617: \tif !in.isTTY {\n618: \t\treturn []reviewtypes.Sink{DumpSink{W: in.out}}\n619: \t}\n620: \tsinks := []reviewtypes.Sink{\n621: \t\tNewTUISink(in.agentNames, in.cancelRun, in.out, os.Stdin),\n622: \t\tDumpSink{W: in.out},\n623: \t}\n624: \tif in.synthesisProvider != nil && in.canPrompt {\n625: \t\tsinks = append(sinks, SynthesisSink{\n626: \t\t\tProvider:     in.synthesisProvider,\n627: \t\t\tWriter:       in.out,\n628: \t\t\tInputTTY:     in.canPrompt,\n629: \t\t\tPromptYN:     in.promptYN,\n630: \t\t\tPerRunPrompt: in.perRunPrompt,\n631: \t\t\tRunContext:   in.runContext,\n632: \t\t\tOnResult:     in.onSynthesisResult,\n633: \t\t})\n634: \t}\n635: \treturn sinks\n636: }\n637: \n638: func writePostReviewManifest(\n639: \tctx context.Context,\n640: \tout io.Writer,\n641: \tworktreeRoot string,\n642: \theadSHA string,\n643: \tsummary reviewtypes.RunSummary,\n644: \taggregateOutput string,\n645: ) {\n646: \tif summary.Cancelled || len(summary.AgentRuns) == 0 {\n647: \t\treturn\n648: \t}\n649: \tmanifest, err := localReviewManifestFromCurrentState(ctx, worktreeRoot, headSHA, summary, aggregateOutput)\n650: \tif err != nil {\n651: \t\tlogging.Debug(ctx, \"review manifest not written\", slog.String(\"error\", err.Error()))\n652: \t\twarnManifestNotWritten(out, \"could not load session state: \"+err.Error())\n653: \t\treturn\n654: \t}\n655: \tif len(manifest.Sources) == 0 {\n656: \t\tlogging.Debug(ctx, \"review manifest not written: no matching review sessions\")\n657: \t\twarnManifestNotWritten(out, \"review session was not tagged as a review (env-var handshake did not reach the hook)\")\n658: \t\treturn\n659: \t}\n660: \tif e